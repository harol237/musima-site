# Cloudflare Pages applique ces règles AVANT de servir un fichier statique.
# Conséquence : ne jamais y faire figurer une adresse qui existe désormais
# en espagnol, sinon la règle masquerait la vraie page.

# --- www vers l'apex ---
https://www.musima.org/*  https://musima.org/:splat  301

# --- Anciennes URL françaises, en place jusqu'au passage au multilingue.
#     L'espagnol occupe maintenant la racine ; le français passe sous /fr.
#     « / » n'est pas redirigé : c'est désormais l'accueil espagnol.
#     « /cookies » non plus : le segment est identique dans les deux
#     langues, la page espagnole occupe légitimement cette adresse.
/association            /fr/association            301
/association/equipe     /fr/association/equipe     301
/evenements             /fr/evenements             301
/evenements/*           /fr/evenements/:splat      301
/intervenants           /fr/intervenants           301
/intervenants/*         /fr/intervenants/:splat    301
/projets                /fr/projets                301
/projets/*              /fr/projets/:splat         301
/recits                 /fr/recits                 301
/recits/*               /fr/recits/:splat          301
/galerie                /fr/galerie                301
/galerie/*              /fr/galerie/:splat         301
/s-engager              /fr/s-engager              301
/contact                /fr/contact                301
/mentions-legales       /fr/mentions-legales       301
/confidentialite        /fr/confidentialite        301

# --- Page accessibilité retirée du site.
#     Les adresses continuent de répondre : un lien déjà partagé, ou
#     déjà indexé, mène à l'accueil de sa langue plutôt qu'à une erreur.
#     L'ancienne adresse française part directement à la bonne place,
#     sans passer par une redirection intermédiaire.
/accessibilite          /fr                        301
/accesibilidad          /                          301
/fr/accessibilite       /fr                        301

# --- Fiche intervenant renommée : « Sebastien Richnel » était une erreur
#     de saisie, le nom réel est Jeffrey Nomba. Les quatre adresses
#     déjà partagées mènent à la fiche corrigée dans leur propre langue.
/ponentes/sebastien-richnel          /ponentes/jeffrey-nomba          301
/fr/intervenants/sebastien-richnel   /fr/intervenants/jeffrey-nomba   301
/en/speakers/sebastien-richnel       /en/speakers/jeffrey-nomba       301
/ca/ponents/sebastien-richnel        /ca/ponents/jeffrey-nomba        301

# --- Album 2025 renommé en archives Inspire BCN. Les adresses de
#     septembre 2026 mènent au même album sous son nouveau nom.
/galeria/galeria-2025       /galeria/archivo-inspire-bcn        301
/fr/galerie/galerie-2025    /fr/galerie/archives-inspire-bcn    301
/en/gallery/gallery-2025    /en/gallery/inspire-bcn-archive     301
