---
interface Props {
  surtitre?: string;
  titre: string;
  texte?: string;
  actions?: { url: string; libelle: string; variante?: 'plein' | 'fantome' }[];
}
const { surtitre, titre, texte, actions = [] } = Astro.props;
---
<section class="section bandeau scene">
  <svg class="bandeau__trait" viewBox="0 0 1200 400" aria-hidden="true" preserveAspectRatio="none">
    <path d="M-40 330 C 180 330 200 90 400 90 C 600 90 620 310 820 310 C 1020 310 1040 120 1260 120" />
  </svg>
  <div class="conteneur bandeau__interieur">
    <div>
      {surtitre && <p class="surtitre">{surtitre}</p>}
      <h2 class="t-section">{titre}</h2>
      {texte && <p class="chapo bandeau__texte">{texte}</p>}
    </div>
    {actions.length > 0 && (
      <div class="rang bandeau__actions">
        {actions.map((action) => (
          <a
            href={action.url}
            class:list={['bouton', action.variante === 'fantome' && 'bouton--fantome']}
          >{action.libelle}</a>
        ))}
      </div>
    )}
  </div>
</section>
<style>
  .bandeau { position: relative; overflow: hidden; }
  .bandeau__trait {
    position: absolute;
    inset: -20% -10%;
    width: 120%;
    height: 140%;
    fill: none;
    stroke: var(--scene-or);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.14;
    pointer-events: none;
  }
  /* Troisième occurrence du même défaut, après le héros et le menu :
     `preserveAspectRatio: none` étire la courbe à la hauteur du bloc.
     Sur une bande étroite et haute — 390 × 580 pour un viewBox de
     1200 × 400 — elle est comprimée quatre fois et descend presque à la
     verticale en travers des boutons. On lui rend le rapport de son
     viewBox et on la pose en bande basse. */
  @media (max-width: 51.99rem) {
    .bandeau__trait {
      inset: auto -20% 6% -20%;
      width: 140%;
      height: auto;
      aspect-ratio: 3 / 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Défilement lié à la position de la bande : aucun écouteur de
       scroll, et rien ne bouge là où la règle n'est pas connue. */
    @supports (animation-timeline: view()) {
      .bandeau__trait {
        animation: bandeau-derive linear both;
        animation-timeline: view();
      }
      @keyframes bandeau-derive {
        from { transform: translateY(24px); }
        to { transform: translateY(-24px); }
      }
    }
  }

  .bandeau__interieur { position: relative; }
  .bandeau__interieur {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--e-6);
  }
  .bandeau__interieur > div:first-child { max-width: 40rem; }
  .bandeau__texte { margin-top: var(--e-4); }
  /* `flex: none` fige la rangée à sa largeur max-content : les deux
     boutons restent côte à côte et débordent sous 400px. On ne la fige
     qu'une fois qu'il y a la place. */
  .bandeau__actions { flex: 0 1 auto; }
  @media (min-width: 40rem) {
    .bandeau__actions { flex: none; }
  }
</style>
