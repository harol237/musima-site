---
interface Props {
  surtitre?: string;
  titre: string;
  lien?: { url: string; libelle: string };
  niveau?: 'h2' | 'h3';
  class?: string;
}
const { surtitre, titre, lien, niveau: Niveau = 'h2', class: classe = '' } = Astro.props;
---
<div class:list={['entete-section', classe]}>
  <div>
    {surtitre && <p class="surtitre">{surtitre}</p>}
    <Niveau class="t-section">{titre}</Niveau>
    {/* Introduction courte, facultative : passée en enfant. */}
    <slot />
  </div>
  {lien && <a href={lien.url} class="bouton bouton--discret lien-suite">{lien.libelle} <span aria-hidden="true">→</span></a>}
</div>
<style>
  .lien-suite { flex: none; padding-bottom: 0.35rem; }
  .entete-section :global(.intro-section) {
    margin-top: var(--e-3);
    font-size: var(--t-400);
    line-height: 1.6;
    color: var(--encre-douce);
    max-width: 46ch;
    text-wrap: pretty;
  }
</style>
