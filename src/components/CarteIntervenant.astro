---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ARemplir from './ARemplir.astro';
import BadgeModele from './BadgeModele.astro';
import VisuelDeSecours from './VisuelDeSecours.astro';
import { chemin, type Langue } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';
import { pret, slugDe } from '~/lib/contenu';
import { nomTransition } from '~/lib/transitions';

interface Props {
  langue: Langue;
  intervenant: CollectionEntry<'intervenants'>;
}
const { intervenant, langue } = Astro.props;
const { data } = intervenant;
const t = traducteur(langue);
const sousTitre = [data.fonction, data.organisation].filter(Boolean).join(' · ');
---
<article class="carte fiche">
  {data.modele && <BadgeModele />}

  <div class="carte__visuel ratio-4-5" style={nomTransition('pt', slugDe(intervenant.id), !!data.photo)}>
    {data.photo ? (
      <Image
        src={data.photo}
        alt={pret(data.photo_alt) ?? `${t('portraitDe')} ${data.nom}`}
        widths={[240, 400, 640]}
        sizes="(min-width: 64rem) 20rem, (min-width: 40rem) 40vw, 85vw"
      />
    ) : (
      <>
        <VisuelDeSecours variante="initiales" texte={data.nom} graine={intervenant.id} />
        <ARemplir type="photo" forme="visuel" class="par-dessus" />
      </>
    )}
  </div>

  {/* Quatre niveaux typographiques en quatre lignes : c'est là que se
      lit la hiérarchie, pas dans la taille des blocs. */}
  <h3 class="fiche__nom">
    <a href={chemin(langue, 'intervenants', slugDe(intervenant.id))} class="carte__lien">{data.nom}</a>
  </h3>

  {sousTitre ? (
    <p class="fiche__role">{sousTitre}</p>
  ) : (
    <ARemplir libelle="FONCTION À AJOUTER" forme="ligne" />
  )}

  {data.territoire && <p class="meta fiche__lieu">{data.territoire}</p>}

  {data.domaines.length > 0 && (
    <ul class="fiche__domaines liste-nue">
      {data.domaines.slice(0, 3).map((domaine) => (
        <li><span class="puce puce--sourde">{domaine}</span></li>
      ))}
    </ul>
  )}
</article>

<style>
  .fiche { gap: var(--e-2); padding: var(--e-4); }
  .fiche .carte__visuel { margin: calc(var(--e-4) * -1) calc(var(--e-4) * -1) var(--e-3); }

  .fiche__nom {
    font-family: var(--f-titre);
    font-size: var(--t-500);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  /* L'italique de Newsreader est chargée et ne servait nulle part :
     c'est ici qu'elle a le plus de sens, sur la ligne de fonction. */
  .fiche__role {
    font-family: var(--f-lecture);
    font-style: italic;
    font-size: var(--t-300);
    color: var(--encre-douce);
    line-height: 1.45;
  }
  .fiche__lieu { font-size: var(--t-100); font-variant-numeric: tabular-nums; }
  .fiche__domaines {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2);
    margin-top: auto;
    padding-top: var(--e-3);
  }

  /* Les portraits viennent de mains différentes : une désaturation légère
     au repos les rassemble, et le survol rend la couleur. */
  @media (prefers-reduced-motion: no-preference) {
    .fiche .carte__visuel :global(img) {
      filter: saturate(0.82);
      transition: filter var(--mv-lent) var(--courbe-arrivee),
                  transform var(--mv-lent) var(--courbe-arrivee);
    }
    .fiche:has(a:hover) .carte__visuel :global(img),
    .fiche:has(a:focus-visible) .carte__visuel :global(img) { filter: saturate(1); }
  }
</style>
