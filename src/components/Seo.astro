---
import site from '~/data/site.json';
import { etiquettes, langueDefaut, langues, prefixe, type Langue } from '~/i18n/config';
import { champ } from '~/i18n/site';
import { traducteur } from '~/i18n/ui';

interface Props {
  titre: string;
  /** Titre de l'onglet, quand il ne suit pas le schéma « Page — MUSIMA ».
      La page Association et la page Participer nomment le leur. */
  titreExact?: string;
  description?: string;
  /** Chemin absolu vers une image de partage (1200×630). */
  image?: string;
  /** Ce qu'on voit sur cette image, pour qui ne la voit pas. */
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile' | 'event';
  publieLe?: Date;
  noindex?: boolean;
  langue: Langue;
  /** URL de cette page dans chaque langue, pour les balises hreflang. */
  versions: Record<Langue, string>;
}
const {
  titre,
  titreExact,
  description: descriptionFournie,
  image,
  imageAlt: imageAltFournie,
  type = 'website',
  publieLe,
  noindex = false,
  langue,
  versions,
} = Astro.props;
const description = descriptionFournie ?? champ(site.description_courte, langue);
const t = traducteur(langue);

/* Le site est construit en `format: 'file'` : Astro.url.pathname vaut
   « /association.html », alors que l'adresse publique — celle du sitemap,
   des liens internes et de la barre d'adresse — est « /association ».
   Sans ce nettoyage, on déclarerait aux moteurs une URL canonique que
   personne ne visite. */
const cheminPublic =
  Astro.url.pathname
    .replace(/index\.html$/, '')
    .replace(/\.html$/, '')
    .replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(cheminPublic, Astro.site).href;
const titreComplet =
  titreExact ??
  (titre === site.nom ? `${site.nom} — ${champ(site.baseline, langue)}` : `${titre} — ${site.nom}`);
/* L'aperçu affiché quand on colle un lien du site dans une messagerie
   ou un réseau social.

   Par défaut, un visuel typographique en 1200×630 dans la langue de la
   page — le logo, les trois verbes, le surtitre de l'accueil et la
   description du site — généré hors du site et déposé dans
   public/partage/. Une page peut fournir le sien par `image` : la page
   d'une rencontre le fait quand un visuel daté existe pour elle. */
const imageParDefaut = `/partage/musima-${langue}.png`;
const chemin = image ?? imageParDefaut;
const imagePartage = new URL(chemin, Astro.site).href;
/* Tous les visuels de public/partage/ font 1200×630 ; une page qui en
   fournit un autre n'est pas tenue à ce format. */
const dimensionsConnues = !image || image.startsWith('/partage/');
const imageAlt = imageAltFournie ?? t('partageAlt');

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.nom,
  description: champ(site.description_courte, langue),
  url: Astro.site?.href,
  areaServed: [champ(site.contact.pays, langue), 'Europe', 'Africa'],
  /* Ni rue ni code postal : l'adresse précise du siège ne figure pas sur
     le site public. Reste la localité, qui suffit à situer l'association
     et que `PostalAddress` accepte seule. */
  address: {
    '@type': 'PostalAddress',
    addressLocality: champ(site.contact.ville, langue),
    addressRegion: champ(site.contact.region, langue),
    addressCountry: 'ES',
  },
};
---

<title>{titreComplet}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{/* Déclare les quatre versions les unes aux autres, plus `x-default`
    pour le visiteur dont la langue ne correspond à aucune des nôtres :
    il atterrit sur l'espagnol, la langue par défaut du site. */}
{!noindex && langues.map((code) => (
  <link rel="alternate" hreflang={etiquettes[code].balise} href={new URL(versions[code], Astro.site).href} />
))}
{!noindex && (
  <link rel="alternate" hreflang="x-default" href={new URL(versions[langueDefaut], Astro.site).href} />
)}
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={site.nom} />
<meta property="og:locale" content={etiquettes[langue].balise.replace('-', '_')} />
{langues.filter((c) => c !== langue).map((c) => (
  <meta property="og:locale:alternate" content={etiquettes[c].balise.replace('-', '_')} />
))}
<meta property="og:type" content={type === 'event' ? 'website' : type} />
<meta property="og:title" content={titreComplet} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imagePartage} />
<meta property="og:image:alt" content={imageAlt} />
{dimensionsConnues && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
{publieLe && <meta property="article:published_time" content={publieLe.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={imagePartage} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="twitter:title" content={titreComplet} />
<meta name="twitter:description" content={description} />

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${traducteur(langue)('navRecits')} — ${site.nom}`}
  href={`${prefixe(langue)}/rss.xml`}
/>

<script type="application/ld+json" set:html={JSON.stringify(organisation)} is:inline />
