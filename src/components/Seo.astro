---
import site from '~/data/site.json';

interface Props {
  titre: string;
  description?: string;
  /** Chemin absolu vers une image de partage (1200×630). */
  image?: string;
  type?: 'website' | 'article' | 'profile' | 'event';
  publieLe?: Date;
  noindex?: boolean;
}
const {
  titre,
  description = site.description_courte,
  image,
  type = 'website',
  publieLe,
  noindex = false,
} = Astro.props;

/* Le site est construit en `format: 'file'` : Astro.url.pathname vaut
   « /association.html », alors que l'adresse publique — celle du sitemap,
   des liens internes et de la barre d'adresse — est « /association ».
   Sans ce nettoyage, on déclarerait aux moteurs une URL canonique que
   personne ne visite. */
const cheminPublic =
  Astro.url.pathname
    .replace(/index\.html$/, '')
    .replace(/\.html$/, '')
    .replace(/(.)\/$/, '$1') || '/';
const canonical = new URL(cheminPublic, Astro.site).href;
const titreComplet = titre === site.nom ? `${site.nom} — ${site.baseline}` : `${titre} — ${site.nom}`;
// [IMAGE DE PARTAGE À AJOUTER] : déposer un visuel 1200×630 dans public/
// et renseigner son chemin ici pour les aperçus sur les réseaux sociaux.
const imagePartage = image ? new URL(image, Astro.site).href : undefined;

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.nom,
  description: site.description_courte,
  url: Astro.site?.href,
  areaServed: [site.contact.pays, 'Europe', 'Afrique'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.contact.ville,
    addressRegion: site.contact.region,
    addressCountry: 'ES',
  },
};
---

<title>{titreComplet}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={site.nom} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:type" content={type === 'event' ? 'website' : type} />
<meta property="og:title" content={titreComplet} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{imagePartage && <meta property="og:image" content={imagePartage} />}
{publieLe && <meta property="article:published_time" content={publieLe.toISOString()} />}

<meta name="twitter:card" content={imagePartage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={titreComplet} />
<meta name="twitter:description" content={description} />

<link rel="alternate" type="application/rss+xml" title={`Récits — ${site.nom}`} href="/rss.xml" />

<script type="application/ld+json" set:html={JSON.stringify(organisation)} is:inline />
