---
/**
 * VISUEL DE SECOURS — ce qui prend la place d'une photo absente.
 *
 * Rien n'est emprunté à une banque d'images et rien n'est inventé : le
 * dessin se compose du contenu lui-même — une date, un titre, des
 * initiales — et des trois couleurs du logo. Une place tenue par une
 * composition se lit comme une intention ; un cadre vide se lit comme
 * un oubli.
 *
 * Le jour où la vraie photo arrive, elle remplace le dessin sans que
 * la mise en page bouge.
 */
import { formaterJourMois } from '~/i18n/utils';
import { langueDefaut, type Langue } from '~/i18n/config';

interface Props {
  variante: 'date' | 'titre' | 'initiales' | 'trame';
  /** Titre (variante « titre ») ou nom (variante « initiales »). */
  texte?: string;
  /** Variante « date ». */
  date?: Date;
  langue?: Langue;
  /** Fait tourner la couleur de fond d'un contenu à l'autre. */
  graine?: string;
  class?: string;
}
const { variante, texte = '', date, langue = langueDefaut, graine = texte, class: classe = '' } = Astro.props;

/* Somme des codes de caractères : deux contenus voisins tombent
   rarement sur la même teinte, et un même contenu garde la sienne
   d'une construction à l'autre. */
const empreinte = [...graine].reduce((somme, c) => somme + c.charCodeAt(0), 0);
const teintes = ['petrole', 'terre', 'or'] as const;
const teinte = variante === 'titre' ? teintes[empreinte % teintes.length] : 'petrole';

const jourMois = date ? formaterJourMois(date, langue) : undefined;

/** « Sébastien Richnel » → « SR ». Une seule lettre s'il n'y a qu'un mot. */
const initiales = texte
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((mot) => [...mot][0]?.toUpperCase() ?? '')
  .join('');
---
<div class:list={['secours', `secours--${teinte}`, `secours--${variante}`, classe]} aria-hidden="true">
  {variante === 'date' && jourMois && (
    <>
      <svg class="secours__trait" viewBox="0 0 1200 400" preserveAspectRatio="none">
        <path d="M-40 330 C 180 330 200 90 400 90 C 600 90 620 310 820 310 C 1020 310 1040 120 1260 120" />
      </svg>
      <p class="secours__date">
        <span class="secours__jour">{jourMois.jour}</span>
        <span class="secours__mois">{jourMois.mois}</span>
      </p>
    </>
  )}

  {variante === 'titre' && (
    <p class="secours__titre">{texte}</p>
  )}

  {variante === 'initiales' && (
    <>
      <svg class="secours__arc" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
        <path d="M 20,32 L 20,56 A 30,30 0 0 0 80,56 L 80,32" />
      </svg>
      <p class="secours__initiales">{initiales}</p>
    </>
  )}
</div>

<style>
  .secours {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    /* La trame diagonale du logo, sous toutes les variantes. */
    background-image: repeating-linear-gradient(
      -45deg,
      rgb(255 255 255 / 0.05) 0 2px,
      transparent 2px 10px
    );
  }
  .secours--petrole { background-color: var(--scene-fond); color: var(--scene-encre); }
  .secours--terre { background-color: var(--marque-terre); color: var(--sur-terre); }
  .secours--or { background-color: var(--marque-or); color: var(--sur-or); }
  /* Neutre : une place réservée, sans mot ni couleur forte. */
  .secours--trame {
    background-color: color-mix(in oklab, var(--or) 6%, var(--surface));
    background-image: repeating-linear-gradient(
      -45deg,
      color-mix(in oklab, var(--or) 16%, transparent) 0 2px,
      transparent 2px 10px
    );
  }

  /* --- Affiche de date --- */
  .secours__trait {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--scene-or);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.35;
  }
  .secours__date {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.1em;
    font-family: var(--f-titre);
    font-variant-numeric: tabular-nums;
    line-height: 0.9;
  }
  .secours__jour {
    font-size: clamp(3rem, 22cqw, 7rem);
    font-weight: 800;
    letter-spacing: -0.05em;
  }
  .secours__mois {
    font-size: clamp(0.75rem, 4cqw, 1.1rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--scene-or);
  }

  /* --- Couverture typographique : le titre déborde le cadre --- */
  .secours--titre { place-items: end start; padding: 0.7em; }
  .secours__titre {
    font-family: var(--f-titre);
    font-size: clamp(1.5rem, 13cqw, 4.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
    /* Rogné par le bord : la composition continue hors du cadre. */
    margin-inline: -0.06em -1.5em;
    text-wrap: balance;
  }

  /* --- Initiales --- */
  .secours__arc {
    position: absolute;
    width: 62%;
    height: 62%;
    fill: none;
    stroke: var(--scene-or);
    stroke-width: 5;
    stroke-linecap: round;
    opacity: 0.5;
  }
  .secours__initiales {
    position: relative;
    font-family: var(--f-titre);
    font-size: clamp(1.75rem, 20cqw, 4rem);
    font-weight: 800;
    letter-spacing: 0.02em;
  }
</style>
