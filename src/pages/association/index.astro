---
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import BandeauCta from '~/components/BandeauCta.astro';
import ARemplir from '~/components/ARemplir.astro';
import site from '~/data/site.json';

const publics = [
  'Les Africains et les personnes issues des diasporas africaines',
  'Les jeunes et les adultes qui souhaitent découvrir d’autres parcours et d’autres possibilités',
  'Les entrepreneurs et les porteurs de projets',
  'Les professionnels et les personnes disposant d’un savoir-faire ou d’une expérience à partager',
  'Les associations, entreprises, institutions et autres acteurs qui peuvent enrichir ces échanges',
];

/* Les trois verbes du positionnement, dans l'ordre où ils se produisent
   pendant une rencontre. */
const verbes = [
  {
    mot: 'Connecter',
    texte:
      'Mettre dans la même pièce des gens qui ne se seraient pas croisés autrement. C’est bête, mais presque tout part de là.',
  },
  {
    mot: 'Bâtir',
    texte:
      'Passer de la conversation à quelque chose de concret : un projet, une collaboration, une compétence transmise. On s’intéresse à ce qui tient dans le temps.',
  },
  {
    mot: 'Impacter',
    texte:
      'Faire en sorte que ça compte au-delà de la soirée — pour les personnes présentes, et pour celles qui liront ce qui s’y est dit.',
  },
];

const tons = [
  'Humain',
  'Accessible',
  'Positif sans être artificiellement motivant',
  'Curieux',
  'Contemporain',
  'Ouvert',
  'Ambitieux mais simple',
  'Concret',
];
---

<Base
  titre="L’association"
  description="MUSIMA met en lumière des personnes, des parcours et des initiatives d’Africains qui entreprennent, créent et innovent. Mission, public, territoire et démarche."
>
  <EntetePage
    surtitre="L’association"
    titre="Ce qu’on fait, et pourquoi"
    chapo={site.phrase}
    ariane={[{ libelle: 'Association' }]}
  />

  <!-- ============ MISSION ============ -->
  <section class="section conteneur deux-colonnes">
    <div class="colonne-titre">
      <EnteteSection surtitre="Mission" titre="Pourquoi MUSIMA existe" />
    </div>
    <div class="prose">
      <p>
        MUSIMA met en lumière des personnes, des parcours, des projets et des initiatives
        d’Africains qui entreprennent, créent, innovent et apportent de la valeur dans leurs
        domaines.
      </p>
      <p>
        À travers des conférences, des rencontres, des contenus et des projets, MUSIMA crée un
        espace où les expériences, les savoir-faire, les idées et les initiatives peuvent se
        rencontrer et circuler.
      </p>
      <p>
        L’objectif est aussi d’ouvrir le champ des possibles : donner à voir des parcours et des
        réalisations qui permettent de découvrir d’autres trajectoires, d’autres références et de
        se dire que certaines choses sont possibles, et qu’il est possible d’aller plus loin.
      </p>
      <p>
        MUSIMA souhaite également contribuer à enrichir le récit sur les Africains et sur
        l’Afrique, en donnant davantage à voir ce qui se construit, ce qui se crée, ce qui évolue
        et ce que les Africains apportent.
      </p>
    </div>
  </section>

  <hr class="conteneur filet" />

  <!-- ============ LES TROIS VERBES ============ -->
  <section class="section conteneur deux-colonnes">
    <div class="colonne-titre">
      <EnteteSection surtitre="Notre boussole" titre="Connecter · Bâtir · Impacter" />
    </div>
    <ol class="verbes">
      {verbes.map((verbe, index) => (
        <li class="verbe apparait">
          <span class="verbe__rang" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="t-carte verbe__mot">{verbe.mot}</h3>
          <p class="verbe__texte">{verbe.texte}</p>
        </li>
      ))}
    </ol>
  </section>

  <hr class="conteneur filet" />

  <!-- ============ PUBLIC ============ -->
  <section class="section conteneur deux-colonnes">
    <div class="colonne-titre">
      <EnteteSection surtitre="Public" titre="Pour qui ?" />
    </div>
    <div class="pile pile-5">
      <ul class="liste-traits">
        {publics.map((element) => <li>{element}</li>)}
      </ul>
      <p class="note">
        MUSIMA ne s’adresse pas qu’à un public africain. Si vous avez envie de découvrir,
        d’apprendre, d’échanger ou de donner un coup de main, vous êtes à votre place.
      </p>
    </div>
  </section>

  <hr class="conteneur filet" />

  <!-- ============ TERRITOIRE ============ -->
  <section class="section conteneur deux-colonnes">
    <div class="colonne-titre">
      <EnteteSection surtitre="Territoire" titre="Un point d’ancrage, pas une limite" />
    </div>
    <div class="pile pile-5">
      <div class="prose">
        <p>
          Le point de départ est la diaspora africaine et ce qu’elle construit dans son
          environnement. MUSIMA démarre en Catalogne, en Espagne, sans se définir comme une
          initiative limitée à un territoire.
        </p>
        <p>
          À terme, l’association peut mettre en lumière des personnes, des projets et des
          initiatives dans différents territoires, notamment en Europe et en Afrique.
        </p>
      </div>
      <div class="ancrages">
        <div class="ancrage">
          <span class="ancrage__etiquette">Aujourd’hui</span>
          <span class="ancrage__valeur">{site.contact.region}, {site.contact.pays}</span>
        </div>
        <div class="ancrage">
          <span class="ancrage__etiquette">Horizon</span>
          <span class="ancrage__valeur">Europe &amp; Afrique</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DIFFÉRENCIATEUR ============ -->
  <section class="section scene">
    <div class="conteneur deux-colonnes">
      <div class="colonne-titre">
        <EnteteSection surtitre="Notre particularité" titre="Montrer que c’est possible" />
      </div>
      <div class="pile pile-6">
        <div class="prose">
          <p>
            MUSIMA ne se définit ni comme une simple organisation d’événements, ni comme un réseau
            professionnel, ni comme une plateforme qui promet de distribuer des opportunités.
          </p>
          <p>
            Sa particularité tient à trois choses, et elles vont ensemble : mettre en lumière des
            personnes et leurs parcours, créer les occasions de se rencontrer, et faire en sorte
            que les idées, les expériences et les savoir-faire circulent au lieu de rester dans
            une cuisine.
          </p>
          <p>
            Le différenciateur est aussi cette volonté de montrer que c’est possible. Pas
            simplement en disant aux gens qu’ils peuvent réussir, mais en leur donnant à voir des
            personnes réelles, des parcours réels et des réalisations réelles.
          </p>
        </div>
        <blockquote class="citation">
          Une rencontre MUSIMA peut commencer par une conférence, mais ce qui peut en découler va
          plus loin : une nouvelle connaissance, une idée, un apprentissage, une collaboration, un
          projet, ou simplement une nouvelle possibilité que quelqu’un n’avait pas envisagée
          auparavant.
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ============ TON ============ -->
  <section class="section conteneur deux-colonnes">
    <div class="colonne-titre">
      <EnteteSection surtitre="Notre façon de parler" titre="Ni misérabilisme, ni vitrine" />
    </div>
    <div class="pile pile-6">
      <ul class="tons">
        {tons.map((ton) => <li><span class="puce puce--sourde">{ton}</span></li>)}
      </ul>
      <div class="prose">
        <p>
          MUSIMA ne parle pas des Africains uniquement à travers leurs difficultés. Elle ne cherche
          pas non plus à présenter une image artificiellement parfaite.
        </p>
        <p>
          Elle montre ce qui existe : des parcours, des expériences, des réussites, des projets,
          des apprentissages, des initiatives — et aussi les chemins qui ont permis d’y arriver.
        </p>
      </div>
    </div>
  </section>

  <hr class="conteneur filet" />

  <!-- ============ ÉQUIPE & CADRE ============ -->
  <section class="section conteneur deux-colonnes">
    <div class="colonne-titre">
      <EnteteSection
        surtitre="Le cadre"
        titre="L’équipe et le fonctionnement"
        lien={{ url: '/association/equipe', libelle: 'Voir l’équipe' }}
      />
    </div>
    <div class="pile pile-4">
      <p class="note">
        Statut juridique, date de création, composition du bureau et rapport d’activité : ces
        informations rendent l’association lisible pour les partenaires et les institutions.
      </p>
      <ARemplir libelle="STATUT, DATE DE CRÉATION ET NUMÉRO D’ENREGISTREMENT À AJOUTER" />
      <ARemplir libelle="COMPOSITION DU BUREAU À AJOUTER" />
      <ARemplir libelle="STATUTS DE L’ASSOCIATION (PDF) À AJOUTER" />
    </div>
  </section>

  <BandeauCta
    surtitre="Contribuer"
    titre="MUSIMA se construit avec celles et ceux qui font"
    actions={[
      { url: '/s-engager', libelle: 'Voir comment s’engager' },
      { url: '/contact', libelle: 'Nous écrire', variante: 'fantome' },
    ]}
  />
</Base>

<style>
  .deux-colonnes { display: grid; gap: var(--e-6); align-items: start; }
  @media (min-width: 60rem) {
    .deux-colonnes { grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); gap: var(--e-10); }
    .colonne-titre { position: sticky; top: 6.5rem; }
    .colonne-titre :global(.entete-section) { margin-bottom: 0; display: block; }
  }

  .liste-traits { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .liste-traits li {
    display: flex;
    gap: var(--e-4);
    padding-block: var(--e-4);
    border-top: 1px solid var(--trait);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .liste-traits li:last-child { border-bottom: 1px solid var(--trait); }
  .liste-traits li::before {
    content: '';
    flex: none;
    width: 1.5rem;
    height: var(--epaisseur-trait);
    border-radius: var(--r-pilule);
    background: var(--or);
    margin-top: 0.75em;
  }

  .note { font-size: var(--t-300); color: var(--encre-douce); max-width: var(--largeur-texte); line-height: 1.65; text-wrap: pretty; }

  .ancrages { display: flex; flex-wrap: wrap; gap: var(--e-3); }
  .ancrage {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--e-4) var(--e-5);
    border: 1px solid var(--trait);
    border-radius: var(--r-carte);
    background: var(--surface);
  }
  .ancrage__etiquette {
    font-family: var(--f-titre);
    font-size: var(--t-100);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--terre);
  }
  .ancrage__valeur { font-family: var(--f-titre); font-size: var(--t-500); font-weight: 600; letter-spacing: -0.02em; }

  .citation {
    border-left: var(--epaisseur-trait) solid var(--or);
    padding-left: var(--e-5);
    font-size: var(--t-500);
    line-height: 1.6;
    color: var(--encre);
    max-width: var(--largeur-texte);
    text-wrap: pretty;
  }

  .verbes {
    display: grid;
    gap: var(--e-6);
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: none;
  }
  @media (min-width: 48rem) {
    .verbes { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--e-5); }
  }
  .verbe {
    display: flex;
    flex-direction: column;
    gap: var(--e-2);
    padding-top: var(--e-4);
    border-top: var(--epaisseur-trait) solid var(--or);
  }
  .verbe__rang {
    font-family: var(--f-titre);
    font-size: var(--t-100);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--encre-faible);
  }
  .verbe__mot { color: var(--terre); }
  .verbe__texte { font-size: var(--t-300); line-height: 1.65; color: var(--encre-douce); text-wrap: pretty; }

  .tons { display: flex; flex-wrap: wrap; gap: var(--e-2); list-style: none; margin: 0; padding: 0; }
</style>
