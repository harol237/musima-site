---
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import ARemplir from '~/components/ARemplir.astro';
import BandeauCta from '~/components/BandeauCta.astro';

/* Les rôles listés correspondent à la structure minimale d'une
   association. Les noms se saisiront quand le bureau sera constitué. */
const roles = ['Présidence', 'Trésorerie', 'Secrétariat', 'Membre du bureau'];
---

<Base
  titre="L’équipe"
  description="Les personnes qui portent MUSIMA : bureau, membres actifs et bénévoles."
>
  <EntetePage
    surtitre="Le cadre"
    titre="L’équipe"
    chapo="MUSIMA est portée par un collectif de personnes bénévoles. Cette page les rend visibles — c’est ce qui rend une association lisible et crédible."
    ariane={[{ libelle: 'Association', url: '/association' }, { libelle: 'Équipe' }]}
  />

  <section class="section conteneur">
    <EnteteSection surtitre="Bureau" titre="Qui porte l’association" />
    <ul class="grille grille--4 liste-nue">
      {roles.map((role) => (
        <li>
          <article class="carte membre">
            <div class="carte__visuel ratio-4-5">
              <ARemplir type="photo" forme="visuel" />
            </div>
            <p class="membre__role">{role}</p>
            <p class="membre__nom"><ARemplir libelle="NOM À AJOUTER" forme="ligne" /></p>
          </article>
        </li>
      ))}
    </ul>
  </section>

  <section class="section conteneur">
    <EnteteSection surtitre="Autour" titre="Bénévoles et contributeurs" />
    <div class="pile pile-4 mesure">
      <p class="note">
        Photographie, captation, rédaction, traduction, accueil, logistique : beaucoup de choses
        reposent sur des contributions ponctuelles. Cette section les reconnaît.
      </p>
      <ARemplir libelle="LISTE DES BÉNÉVOLES ET CONTRIBUTEURS À AJOUTER" />
    </div>
  </section>

  <BandeauCta
    surtitre="Rejoindre"
    titre="Envie de faire partie de l’équipe ?"
    actions={[{ url: '/s-engager', libelle: 'Devenir bénévole' }]}
  />
</Base>

<style>
  .liste-nue { list-style: none; margin: 0; padding: 0; }
  .membre { gap: var(--e-2); padding: var(--e-4); }
  .membre .carte__visuel { margin: calc(var(--e-4) * -1) calc(var(--e-4) * -1) var(--e-3); }
  .membre__role {
    font-family: var(--f-titre);
    font-size: var(--t-100);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--terre);
  }
  .membre__nom { font-size: var(--t-300); }
  .note { font-size: var(--t-300); color: var(--encre-douce); line-height: 1.65; }
</style>
