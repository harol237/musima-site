---
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import { chemin, langues, etiquettes, langueDefaut } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';

/* Une seule page d'erreur, servie par l'hébergeur quelle que soit
   l'URL demandée. Elle est donc dans la langue par défaut, avec un
   retour vers l'accueil de chacune des quatre. */
const langue = langueDefaut;
const t = traducteur(langue);
---
<Base titre={t('erreurTitre')} description={t('erreurTexte')} noindex langue={langue}>
  <EntetePage surtitre={t('erreurSurtitre')} titre={t('erreurTitre')} chapo={t('erreurTexte')} />
  <section class="section conteneur">
    <ul class="retours">
      {langues.map((code) => (
        <li>
          <a href={chemin(code)} class="bouton bouton--fantome" lang={etiquettes[code].balise}>
            {etiquettes[code].court} · {traducteur(code)('retourAccueil')}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
<style>
  .retours { display: flex; flex-wrap: wrap; gap: var(--e-3); list-style: none; margin: 0; padding: 0; }
</style>
