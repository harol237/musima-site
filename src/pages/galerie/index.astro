---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import EtatVide from '~/components/EtatVide.astro';
import ARemplir from '~/components/ARemplir.astro';
import BadgeModele from '~/components/BadgeModele.astro';
import { chargerAlbums, formaterDate, enChantier } from '~/lib/contenu';

const albums = await chargerAlbums();
---

<Base
  titre="Galerie"
  description="Les photos des rencontres et des projets MUSIMA, classées par album."
  noindex={albums.length === 0}
>
  <EntetePage
    surtitre="Photos"
    titre="Galerie"
    chapo="Ce qui s’est passé, en images. Chaque album regroupe les photos d’une rencontre ou d’un projet."
    ariane={[{ libelle: 'Galerie' }]}
  />

  <section class="section conteneur">
    {albums.length > 0 ? (
      <ul class="grille grille--2 liste-nue">
        {albums.map((album) => (
          <li>
            <article class="carte album">
              {album.data.modele && <BadgeModele />}
              {(album.data.couverture || enChantier) && (
              <div class="carte__visuel ratio-3-2">
                {album.data.couverture ? (
                  <Image src={album.data.couverture} alt={album.data.couverture_alt ?? ''} widths={[400, 700, 1000]} sizes="(min-width: 64rem) 22rem, 90vw" />
                ) : (
                  <ARemplir type="photo" forme="visuel" />
                )}
              </div>
              )}
              <h2 class="t-carte">
                <a href={`/galerie/${album.id}`} class="carte__lien">{album.data.titre}</a>
              </h2>
              <p class="meta">
                {album.data.date && formaterDate(album.data.date)}
                {album.data.lieu && <> · {album.data.lieu}</>}
              </p>
              <p class="album__compte">
                {album.data.photos.length > 0
                  ? `${album.data.photos.length} photo${album.data.photos.length > 1 ? 's' : ''}`
                  : 'Album vide — photos à téléverser'}
              </p>
            </article>
          </li>
        ))}
      </ul>
    ) : (
      <EtatVide
        titre="Aucun album pour le moment"
        texte="Les photos des rencontres seront regroupées ici, album par album."
      />
    )}
  </section>
</Base>

<style>
  .liste-nue { list-style: none; margin: 0; padding: 0; }
  .album__compte { font-family: var(--f-titre); font-size: var(--t-200); color: var(--encre-faible); }
</style>
