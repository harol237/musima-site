---
import Base from '~/layouts/Base.astro';
import LegalEs from './textes/LegalEs.astro';
import LegalFr from './textes/LegalFr.astro';
import LegalEn from './textes/LegalEn.astro';
import LegalCa from './textes/LegalCa.astro';
import type { Langue } from '~/i18n/config';

interface Props { langue: Langue; alternatives: Record<Langue, string> }
const { langue, alternatives } = Astro.props;

const meta = {
  es: {
    titre: 'Aviso legal',
    description: 'Editor, alojamiento, condiciones de uso e información legal de la web de MUSIMA.',
  },
  fr: {
    titre: 'Mentions légales',
    description: "Éditeur, hébergeur, conditions d'utilisation et informations légales du site MUSIMA.",
  },
  en: {
    titre: 'Legal notice',
    description: 'Publisher, host, terms of use and legal information for the MUSIMA site.',
  },
  ca: {
    titre: 'Avís legal',
    description: 'Editor, allotjament, condicions d’ús i informació legal del web de MUSIMA.',
  },
} as const;
const { titre, description } = meta[langue];
---
<Base titre={titre} description={description} langue={langue} alternatives={alternatives}>
  {langue === 'es' && <LegalEs />}
  {langue === 'fr' && <LegalFr />}
  {langue === 'en' && <LegalEn />}
  {langue === 'ca' && <LegalCa />}
</Base>
