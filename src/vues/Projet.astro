---
import { getEntries, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import CarteIntervenant from '~/components/CarteIntervenant.astro';
import ARemplir from '~/components/ARemplir.astro';
import VisuelDeSecours from '~/components/VisuelDeSecours.astro';
import { estPublie, pret, slugDe } from '~/lib/contenu';
import { nomTransition } from '~/lib/transitions';
import { chemin, type Langue } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';

interface Props {
  langue: Langue;
  alternatives: Record<Langue, string>;
  projet: CollectionEntry<'projets'>;
}
const { projet, langue, alternatives } = Astro.props;
const t = traducteur(langue);
const { data } = projet;
const { Content } = await render(projet);
const intervenants = data.intervenants.length ? await getEntries(data.intervenants) : [];
---

<Base
  titre={data.meta_titre ?? data.titre}
  description={data.meta_description ?? data.resume}
  noindex={data.modele}
  langue={langue}
  alternatives={alternatives}
>
  <EntetePage
    surtitre={t('labelProjet')}
    titre={data.titre}
    chapo={data.resume}
    ariane={[{ libelle: t('navProjets'), url: chemin(langue, 'projets') }, { libelle: data.titre }]}
  >
    {data.modele && <p class="rappel-modele">Fiche de démonstration — à remplacer ou supprimer dans le CMS.</p>}
    <div class="rang">
      <span class="puce puce--or">{data.statut}</span>
      {data.annee && <span class="puce puce--sourde">{data.annee}</span>}
      {data.territoire && <span class="puce puce--sourde">{data.territoire}</span>}
    </div>
  </EntetePage>

  <div class="conteneur page-projet">
    <article>
      <div class="visuel-principal tirage ratio-3-2" style={nomTransition('pj', slugDe(projet.id), !!data.image)}>
        {data.image ? (
          <Image src={data.image} alt={pret(data.image_alt) ?? ''} widths={[640, 1000, 1400]} sizes="(min-width: 64rem) 46rem, 100vw" />
        ) : (
          <>
            <VisuelDeSecours variante="titre" texte={data.titre} graine={projet.id} />
            <ARemplir type="photo" forme="visuel" class="par-dessus" />
          </>
        )}
      </div>
      <div class="prose"><Content /></div>
    </article>

    <aside aria-label={t('infosProjet')}>
      <div class="encart">
        <h2 class="encart__titre">{t('labelPartenaires')}</h2>
        {data.partenaires.length > 0 ? (
          <ul class="encart__liste">{data.partenaires.map((p) => <li>{p}</li>)}</ul>
        ) : (
          <ARemplir libelle="PARTENAIRES À AJOUTER" />
        )}
        {data.lien ? (
          <a href={data.lien} class="bouton encart__action" rel="noopener">{t('voirLeProjet')}</a>
        ) : (
          <div class="encart__action"><ARemplir type="lien" /></div>
        )}
      </div>
    </aside>
  </div>

  {intervenants.length > 0 && (
    <section class="section conteneur">
      <EnteteSection surtitre={t('impliques')} titre={t('personnesDuProjet')} />
      <ul class="grille grille--3 liste-nue">
        {intervenants.map((intervenant, index) => (
          <li class="apparait apparait--image" style={`--i:${index}`}>
            <CarteIntervenant intervenant={intervenant} langue={langue} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* Chaque projet ouvre une porte vers Participer : la page cesse
      d'informer et commence à demander. */}
  <section class="section conteneur">
    <div class="aide">
      <p class="aide__titre">{t('commentAider')}</p>
      <a href={chemin(langue, 'engagement')} class="bouton bouton--fantome">{t('ctaVoirEngagement')}</a>
    </div>
  </section>
</Base>

<style>
  .aide {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    padding: var(--e-6);
    border: 1px solid var(--trait);
    border-left: var(--epaisseur-trait) solid var(--or);
    border-radius: var(--r-carte);
    background: var(--surface);
  }
  .aide__titre {
    font-family: var(--f-titre);
    font-size: var(--t-500);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .page-projet { display: grid; gap: var(--e-8); align-items: start; padding-block: var(--e-8); }
  @media (min-width: 62rem) {
    .page-projet { grid-template-columns: minmax(0, 1fr) 18rem; gap: var(--e-9); }
    .page-projet aside { position: sticky; top: 6.5rem; }
  }
  .visuel-principal { border-radius: var(--r-image); overflow: hidden; background: var(--surface-2); margin-bottom: var(--e-6); }
  .visuel-principal :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .encart { border: 1px solid var(--trait); border-radius: var(--r-carte); background: var(--surface); padding: var(--e-5); }
  .encart__titre { font-size: var(--t-200); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--terre); margin-bottom: var(--e-4); }
  .encart__liste { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--e-2); font-size: var(--t-300); }
  .encart__action { margin-top: var(--e-5); width: 100%; justify-content: center; }
  .rappel-modele { font-family: var(--f-titre); font-size: var(--t-200); color: var(--or); }
  .liste-nue { list-style: none; margin: 0; padding: 0; }
</style>
