---
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import ARemplir from '~/components/ARemplir.astro';
import VisuelDeSecours from '~/components/VisuelDeSecours.astro';
import BandeauCta from '~/components/BandeauCta.astro';
import { enChantier } from '~/lib/contenu';
import { chemin, type Langue } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';

interface Props { langue: Langue; alternatives: Record<Langue, string> }
const { langue, alternatives } = Astro.props;
const t = traducteur(langue);

const textes = {
  es: {
    meta: 'Las personas que llevan MUSIMA: junta directiva, miembros activos y voluntariado.',
    surtitre: 'El marco',
    titre: 'El equipo',
    chapo: 'MUSIMA la sostiene un grupo de personas voluntarias. Esta página las hace visibles — es lo que vuelve legible y creíble a una asociación.',
    bureauSurtitre: 'Junta directiva',
    bureauTitre: 'Quién sostiene la asociación',
    roles: ['Presidencia', 'Tesorería', 'Secretaría', 'Vocalía'],
    nomAAjouter: 'NOMBRE POR AÑADIR',
    autourSurtitre: 'Alrededor',
    autourTitre: 'Voluntariado y colaboraciones',
    autourNote: 'Fotografía, grabación, redacción, traducción, acogida, logística: muchas cosas se sostienen sobre aportaciones puntuales. Este apartado las reconoce.',
    ctaSurtitre: 'Sumarte',
    ctaTitre: '¿Te apetece formar parte del equipo?',
    ctaBouton: 'Echar una mano',
  },
  fr: {
    meta: 'Les personnes qui portent MUSIMA : bureau, membres actifs et bénévoles.',
    surtitre: 'Le cadre',
    titre: 'L’équipe',
    chapo: 'MUSIMA est portée par un collectif de personnes bénévoles. Cette page les rend visibles — c’est ce qui rend une association lisible et crédible.',
    bureauSurtitre: 'Bureau',
    bureauTitre: 'Qui porte l’association',
    roles: ['Présidence', 'Trésorerie', 'Secrétariat', 'Membre du bureau'],
    nomAAjouter: 'NOM À AJOUTER',
    autourSurtitre: 'Autour',
    autourTitre: 'Bénévoles et contributeurs',
    autourNote: 'Photographie, captation, rédaction, traduction, accueil, logistique : beaucoup de choses reposent sur des contributions ponctuelles. Cette section les reconnaît.',
    ctaSurtitre: 'Rejoindre',
    ctaTitre: 'Envie de faire partie de l’équipe ?',
    ctaBouton: 'Devenir bénévole',
  },
  en: {
    meta: 'The people who run MUSIMA: the board, active members and volunteers.',
    surtitre: 'The frame',
    titre: 'The team',
    chapo: 'MUSIMA is held up by a group of volunteers. This page puts names to them — that is what makes an association legible, and worth trusting.',
    bureauSurtitre: 'The board',
    bureauTitre: 'Who holds the association up',
    roles: ['Chair', 'Treasurer', 'Secretary', 'Board member'],
    nomAAjouter: 'NAME TO ADD',
    autourSurtitre: 'Around it',
    autourTitre: 'Volunteers and contributors',
    autourNote: 'Photography, filming, writing, translation, welcoming people, logistics: a lot of it rests on one-off contributions. This section names them.',
    ctaSurtitre: 'Join in',
    ctaTitre: 'Fancy being part of the team?',
    ctaBouton: 'Lend a hand',
  },
  ca: {
    meta: 'Les persones que duen MUSIMA: junta directiva, membres actius i voluntariat.',
    surtitre: 'El marc',
    titre: 'L’equip',
    chapo: 'MUSIMA la sosté un grup de persones voluntàries. Aquesta pàgina les fa visibles — és el que fa que una associació sigui llegible i creïble.',
    bureauSurtitre: 'Junta directiva',
    bureauTitre: 'Qui sosté l’associació',
    roles: ['Presidència', 'Tresoreria', 'Secretaria', 'Vocalia'],
    nomAAjouter: 'NOM PER AFEGIR',
    autourSurtitre: 'Al voltant',
    autourTitre: 'Voluntariat i col·laboracions',
    autourNote: 'Fotografia, gravació, redacció, traducció, acollida, logística: moltes coses se sostenen sobre aportacions puntuals. Aquest apartat les reconeix.',
    ctaSurtitre: 'Sumar-t’hi',
    ctaTitre: 'Tens ganes de formar part de l’equip?',
    ctaBouton: 'Donar un cop de mà',
  },
} as const;
const x = textes[langue];
---

<Base
  titre={x.titre}
  description={x.meta}
  langue={langue}
  alternatives={alternatives}
  noindex={!enChantier}
>
  <EntetePage
    surtitre={x.surtitre}
    titre={x.titre}
    chapo={x.chapo}
    ariane={[{ libelle: t('navAssociation'), url: chemin(langue, 'association') }, { libelle: x.titre }]}
  />

  <section class="section conteneur">
    <EnteteSection surtitre={x.bureauSurtitre} titre={x.bureauTitre} />
    <ul class="grille grille--3 liste-nue">
      {x.roles.map((role, index) => (
        <li class="apparait" style={`--i:${index}`}>
          <article class="carte membre">
            <div class="carte__visuel ratio-4-5">
              <VisuelDeSecours variante="trame" />
              <ARemplir type="photo" forme="visuel" class="par-dessus" />
            </div>
            <p class="membre__role">{role}</p>
            <p class="membre__nom"><ARemplir libelle={x.nomAAjouter} forme="ligne" /></p>
          </article>
        </li>
      ))}
    </ul>
  </section>

  <section class="section conteneur">
    <EnteteSection surtitre={x.autourSurtitre} titre={x.autourTitre} />
    <div class="pile pile-4 mesure">
      <p class="note">{x.autourNote}</p>
      <ARemplir libelle="LISTE DES BÉNÉVOLES ET CONTRIBUTEURS À AJOUTER" />
    </div>
  </section>

  <BandeauCta
    surtitre={x.ctaSurtitre}
    titre={x.ctaTitre}
    actions={[{ url: chemin(langue, 'engagement'), libelle: x.ctaBouton }]}
  />
</Base>
<style>
  .liste-nue { list-style: none; margin: 0; padding: 0; }
  .membre { gap: var(--e-2); padding: var(--e-4); }
  .membre .carte__visuel { margin: calc(var(--e-4) * -1) calc(var(--e-4) * -1) var(--e-3); }
  .membre__role {
    font-family: var(--f-titre);
    font-size: var(--t-400);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-transform: none;
    color: var(--encre);
  }
  .membre__nom { font-size: var(--t-300); }
  .note { font-size: var(--t-300); color: var(--encre-douce); line-height: 1.65; }
</style>
