---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import ARemplir from '~/components/ARemplir.astro';
import BadgeModele from '~/components/BadgeModele.astro';
import Mosaique from '~/components/Mosaique.astro';
import { slugDe } from '~/lib/contenu';
import { formaterDate } from '~/i18n/utils';
import { chemin, type Langue } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';

interface Props {
  langue: Langue;
  alternatives: Record<Langue, string>;
  album: CollectionEntry<'albums'>;
}
const { album, langue, alternatives } = Astro.props;
const t = traducteur(langue);
const { data } = album;
const { Content } = await render(album);
const evenement = data.evenement ? await getEntry(data.evenement) : undefined;
---

<Base
  titre={data.titre}
  description={data.meta_description}
  langue={langue}
  alternatives={alternatives}
  noindex={data.modele}
>
  <EntetePage
    surtitre={t('albumSurtitre')}
    titre={data.titre}
    ariane={[
      { libelle: t('navGalerie'), url: chemin(langue, 'galerie') },
      { libelle: data.titre },
    ]}
  >
    {data.modele && <BadgeModele />}
    <p class="meta">
      {data.date && formaterDate(data.date, langue)}
      {data.date && data.lieu && <> · </>}
      {data.lieu}
    </p>
    {evenement && (
      <a
        href={chemin(langue, 'evenements', slugDe(evenement.id))}
        class="bouton bouton--fantome"
      >
        {t('albumRencontre')}
      </a>
    )}
  </EntetePage>

  <section class="section conteneur">
    <div class="prose album__intro"><Content /></div>

    {data.photos.length > 0 ? (
      <Mosaique photos={data.photos} langue={langue} />
    ) : (
      <div class="album-vide">
        <ARemplir libelle="PHOTOS À TÉLÉVERSER DANS CET ALBUM" />
      </div>
    )}
  </section>
</Base>

<style>
  .album__intro { margin-bottom: var(--e-7); }
  .album-vide { margin-top: var(--e-6); max-width: var(--largeur-texte); }
</style>
