---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import ARemplir from '~/components/ARemplir.astro';
import { estPublie } from '~/lib/contenu';
import { formaterDate } from '~/i18n/utils';
import { chemin, type Langue } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';

interface Props {
  langue: Langue;
  alternatives: Record<Langue, string>;
  album: CollectionEntry<'albums'>;
}
const { album, langue, alternatives } = Astro.props;
const t = traducteur(langue);
const { data } = album;
const { Content } = await render(album);
const evenement = data.evenement ? await getEntry(data.evenement) : undefined;
---

<Base titre={data.titre} description={data.meta_description}>
  <EntetePage
    surtitre="Album"
    titre={data.titre}
    ariane={[{ libelle: 'Galerie', url: '/galerie' }, { libelle: data.titre }]}
  >
    <p class="meta">
      {data.date && formaterDate(data.date)}
      {data.lieu && <> · {data.lieu}</>}
    </p>
    {evenement && (
      <a href={`/evenements/${evenement.id}`} class="bouton bouton--fantome">
        Voir la rencontre associée
      </a>
    )}
  </EntetePage>

  <section class="section conteneur">
    <div class="prose"><Content /></div>

    {data.photos.length > 0 ? (
      <ul class="mosaique">
        {data.photos.map((photo) => (
          <li>
            <figure>
              <Image src={photo.fichier} alt={photo.alt} widths={[400, 800, 1200]} sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 45vw, 92vw" />
              {photo.credit && <figcaption>{photo.credit}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    ) : (
      <div class="album-vide">
        <ARemplir libelle="PHOTOS À TÉLÉVERSER DANS CET ALBUM" />
        <p class="album-vide__aide">
          Les photos s’ajoutent depuis le CMS, dans la fiche de cet album. Chaque image demande une
          description : c’est ce qui permet aux personnes aveugles ou malvoyantes de savoir ce
          qu’elle montre.
        </p>
      </div>
    )}
  </section>
</Base>

<style>
  .mosaique {
    list-style: none;
    margin: var(--e-7) 0 0;
    padding: 0;
    display: grid;
    gap: var(--e-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  .mosaique figure { margin: 0; }
  .mosaique :global(img) { width: 100%; border-radius: var(--r-image); }
  .mosaique figcaption { font-family: var(--f-titre); font-size: var(--t-100); color: var(--encre-faible); margin-top: var(--e-2); }

  .album-vide { display: flex; flex-direction: column; gap: var(--e-4); margin-top: var(--e-6); max-width: var(--largeur-texte); }
  .album-vide__aide { font-size: var(--t-300); color: var(--encre-douce); line-height: 1.6; }
</style>
