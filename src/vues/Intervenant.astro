---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import FilDAriane from '~/components/FilDAriane.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import CarteEvenement from '~/components/CarteEvenement.astro';
import CarteRecit from '~/components/CarteRecit.astro';
import ARemplir from '~/components/ARemplir.astro';
import { estPublie, pret } from '~/lib/contenu';
import { chemin, type Langue } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';

interface Props {
  langue: Langue;
  alternatives: Record<Langue, string>;
  intervenant: CollectionEntry<'intervenants'>;
}
const { intervenant, langue, alternatives } = Astro.props;
const t = traducteur(langue);
const { data } = intervenant;
const { Content } = await render(intervenant);

const evenements = (await getCollection('evenements'))
  .filter(estPublie)
  .filter((e) => e.data.intervenants.some((ref) => ref.id === intervenant.id))
  .sort((a, b) => b.data.date_debut.getTime() - a.data.date_debut.getTime());

const recits = (await getCollection('recits'))
  .filter(estPublie)
  .filter((r) => r.data.intervenants.some((ref) => ref.id === intervenant.id))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const liens = Object.entries(data.liens ?? {}).filter(([, url]) => url);
const sousTitre = [data.fonction, data.organisation].filter(Boolean).join(' · ');

const donnees = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: data.nom,
  ...(data.fonction ? { jobTitle: data.fonction } : {}),
  ...(data.organisation ? { worksFor: { '@type': 'Organization', name: data.organisation } } : {}),
};
---

<Base
  titre={data.meta_titre ?? data.nom}
  description={data.meta_description ?? data.accroche}
  type="profile"
  noindex={data.modele}
  langue={langue}
  alternatives={alternatives}
>
  <section class="entete-profil scene">
    <div class="conteneur">
      <FilDAriane elements={[{ libelle: 'Intervenants', url: '/intervenants' }, { libelle: data.nom }]} />

      <div class="profil">
        <div class="profil__portrait ratio-4-5">
          {data.photo ? (
            <Image src={data.photo} alt={pret(data.photo_alt) ?? `Portrait de ${data.nom}`} widths={[320, 520, 780]} sizes="(min-width: 62rem) 20rem, 70vw" />
          ) : (
            <ARemplir type="photo" forme="visuel" />
          )}
        </div>

        <div class="profil__texte">
          {data.modele && <p class="rappel-modele">Fiche de démonstration — à remplacer ou supprimer dans le CMS.</p>}
          <h1 class="t-page">{data.nom}</h1>
          {sousTitre ? <p class="profil__role">{sousTitre}</p> : <ARemplir libelle="FONCTION À AJOUTER" forme="ligne" />}
          {data.territoire && <p class="meta">{data.territoire}</p>}
          {data.accroche && <p class="chapo">{data.accroche}</p>}

          {data.domaines.length > 0 && (
            <ul class="profil__domaines">
              {data.domaines.map((domaine) => <li><span class="puce puce--sourde">{domaine}</span></li>)}
            </ul>
          )}

          {liens.length > 0 ? (
            <ul class="profil__liens">
              {liens.map(([nom, url]) => (
                <li><a href={url} class="lien" rel="noopener">{nom}</a></li>
              ))}
            </ul>
          ) : (
            <ARemplir libelle="LIENS (SITE, LINKEDIN…) À AJOUTER" forme="ligne" />
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section conteneur">
    <div class="prose"><Content /></div>
    {pret(data.credit_photo) && <p class="credit">Portrait : {data.credit_photo}</p>}
  </section>

  {evenements.length > 0 && (
    <section class="section conteneur">
      <EnteteSection surtitre="Participations" titre="Rencontres MUSIMA" />
      <ul class="pile pile-4 liste-nue">
        {evenements.map((evenement) => <li><CarteEvenement evenement={evenement} /></li>)}
      </ul>
    </section>
  )}

  {recits.length > 0 && (
    <section class="section conteneur">
      <EnteteSection surtitre="À lire" titre="Récits liés" />
      <ul class="grille grille--2 liste-nue">
        {recits.map((recit) => <li><CarteRecit recit={recit} /></li>)}
      </ul>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(donnees)} is:inline />
</Base>

<style>
  .entete-profil { padding-block: var(--e-6) var(--e-8); border-bottom: 1px solid var(--trait); }

  .profil { display: grid; gap: var(--e-6); margin-top: var(--e-5); align-items: start; }
  @media (min-width: 62rem) {
    .profil { grid-template-columns: 20rem minmax(0, 1fr); gap: var(--e-8); }
  }

  .profil__portrait {
    border-radius: var(--r-image);
    overflow: hidden;
    background: var(--surface);
    max-width: 20rem;
  }
  .profil__portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .profil__texte { display: flex; flex-direction: column; align-items: flex-start; gap: var(--e-3); }
  .profil__role { font-size: var(--t-500); color: var(--encre-douce); }
  .profil__domaines,
  .profil__liens { display: flex; flex-wrap: wrap; gap: var(--e-2); list-style: none; margin: var(--e-2) 0 0; padding: 0; }
  .profil__liens { gap: var(--e-5); }
  .profil__liens a { font-family: var(--f-titre); font-size: var(--t-300); text-transform: capitalize; }

  .rappel-modele { font-family: var(--f-titre); font-size: var(--t-200); color: var(--or); }
  .credit { font-family: var(--f-titre); font-size: var(--t-100); color: var(--encre-faible); margin-top: var(--e-5); }
  .liste-nue { list-style: none; margin: 0; padding: 0; }
</style>
