---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import CarteEvenement from '~/components/CarteEvenement.astro';
import CarteIntervenant from '~/components/CarteIntervenant.astro';
import CarteProjet from '~/components/CarteProjet.astro';
import CarteRecit from '~/components/CarteRecit.astro';
import BandeauCta from '~/components/BandeauCta.astro';
import CompteARebours from '~/components/CompteARebours.astro';
import EtatVide from '~/components/EtatVide.astro';
import site from '~/data/site.json';
import { champ } from '~/i18n/site';
import {
  chargerEvenements,
  chargerIntervenants,
  chargerProjets,
  chargerRecits,
  enChantier,
} from '~/lib/contenu';
import { formaterDate } from '~/i18n/utils';
import { horodatageISO } from '~/lib/contenu';
import { chemin, type Langue } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';
import { accueilPar, ancreEcosysteme } from '~/i18n/accueil';
import { parametreMotif, ancreFormulaire } from '~/i18n/formulaire';

/* Photo d'ouverture. Le héros retrouve sa seconde colonne dès qu'elle
   existe ; à `null`, il se replie sur une seule colonne plutôt que
   d'afficher un cadre vide. */
import ouverture from '~/assets/uploads/pages/accueil.jpg';

/* La colonne d'image des quatre manières : une main qui écrit dans un
   carnet. Elle répond à la troisième — « Faire circuler » : ce qui est
   noté continue de servir à quelqu'un d'autre. */
import trace from '~/assets/uploads/pages/cequefaitmusima.jpg';

interface Props { langue: Langue; alternatives: Record<Langue, string> }
const { langue, alternatives } = Astro.props;
const t = traducteur(langue);
const a = accueilPar[langue];

const { aVenir } = await chargerEvenements(langue);
const intervenants = await chargerIntervenants(langue);
const projets = await chargerProjets(langue);
const recits = await chargerRecits(langue);

const prochaine = aVenir[0];
const suivants = aVenir.slice(1, 4);

const enAvant = <T extends { data: { en_avant: boolean } }>(liste: T[], nombre: number) => {
  const mis = liste.filter((e) => e.data.en_avant);
  return (mis.length ? mis : liste).slice(0, nombre);
};

/* Le bouton de l'écosystème ouvre le formulaire sur le motif qui
   correspond : une seule porte d'entrée, comme pour les voies de la
   page Participer. */
const lienEcosysteme = `${chemin(langue, 'contact')}?${parametreMotif[langue]}=adherer#${ancreFormulaire[langue]}`;

/* Ligne de données du héros : la date, le lieu et le tarif de la
   prochaine rencontre. Trois informations réelles, ou rien. */
const reperes = prochaine
  ? [
      formaterDate(prochaine.data.date_debut, langue, { day: 'numeric', month: 'long' }),
      prochaine.data.lieu?.ville,
      prochaine.data.tarif,
    ].filter(Boolean)
  : [];
---

<Base
  titre={site.nom}
  description={champ(site.description_courte, langue)}
  langue={langue}
  alternatives={alternatives}
>
  <!-- ================= HÉROS ================= -->
  <section class="heros scene">
    <svg class="heros__trait" viewBox="0 0 1200 400" aria-hidden="true" preserveAspectRatio="none">
      <path d="M-40 330 C 180 330 200 90 400 90 C 600 90 620 310 820 310 C 1020 310 1040 120 1260 120" />
    </svg>

    <div class="conteneur heros__interieur">
      <div class="heros__texte">
        <p class="surtitre heros__surtitre">{t('heroSurtitre')}</p>
        {/* Les trois verbes empilés, alignés à gauche sur la même
            verticale que le surtitre, le chapô et les boutons. Les
            points médians restent, posés en fin de ligne : ils marquent
            le rythme sans casser la colonne. Le dernier n'en a pas —
            il n'y a rien après lui. */}
        <h1 class="t-hero heros__titre">
          {a.verbes.map((mot, index) => (
            <span class="heros__mot">
              <span class="heros__verbe">{mot}</span>
              {index < a.verbes.length - 1 && (
                <span class="heros__point" aria-hidden="true">·</span>
              )}
            </span>
          ))}
        </h1>
        <p class="chapo heros__chapo">{t('heroChapo')}</p>
        <div class="rang heros__actions">
          <a href={chemin(langue, 'association')} class="bouton">{t('heroBoutonDecouvrir')}</a>
          <a href={chemin(langue, 'engagement')} class="bouton bouton--fantome">
            {t('heroBoutonParticiper')}
          </a>
        </div>

        {reperes.length > 0 && (
          <p class="heros__reperes">
            {reperes.map((repere) => <span class="heros__repere">{repere}</span>)}
            {/* Quatrième donnée de la même ligne, dans la même typo et
                les mêmes chiffres tabulaires. Rien de neuf à l'écran :
                le compte à rebours est un repère parmi les autres, pas
                une alarme posée par-dessus le héros. */}
            {prochaine?.data.heure_debut && (
              <CompteARebours
                  langue={langue}
                  variante="ligne"
                  debut={horodatageISO(prochaine.data.date_debut, prochaine.data.heure_debut)}
                  fin={horodatageISO(prochaine.data.date_fin ?? prochaine.data.date_debut, prochaine.data.heure_fin)}
                />
            )}
          </p>
        )}
      </div>

      {ouverture && (
        <div class="heros__visuel tirage">
          <Image
            src={ouverture}
            alt={t('ouvertureAlt')}
            widths={[420, 640, 832]}
            sizes="(min-width: 62rem) 26rem, 92vw"
            loading="eager"
          />
        </div>
      )}
    </div>
  </section>

  <!-- ================= QUI EST MUSIMA ================= -->
  <section class="section conteneur colonnes colonnes--collant section--apres-heros">
    <div>
      <EnteteSection surtitre={a.qui.surtitre} titre={a.qui.titre} />
    </div>
    <div class="prose">
      {a.qui.texte.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <!-- ================= LE CONSTAT =================
       Sur fond profond : c'est le seul endroit de la page qui pose un
       problème avant de proposer quelque chose, et il gagne à être lu
       d'un bloc, détaché des sections claires qui l'entourent. -->
  <section class="section scene">
    <div class="conteneur">
      <EnteteSection surtitre={a.constat.surtitre} titre={a.constat.titre} />
      <div class="constat">
        <p class="constat__enumeration">{a.constat.texte[0]}</p>
        <p class="constat__corps">{a.constat.texte[1]}</p>
        <p class="constat__phrase">{a.constat.phrase}</p>
      </div>
    </div>
  </section>

  <!-- ================= COMMENT NOUS AGISSONS ================= -->
  <section class="section conteneur">
    <EnteteSection surtitre={a.role.surtitre} titre={a.triade} />
    <ol class="verbes">
      {a.role.verbes.map((verbe, index) => (
        <li class="verbe apparait" style={`--i:${index}`}>
          <span class="trait-croissant verbe__trait" style={`--i:${index}`}></span>
          <span class="verbe__rang" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="verbe__mot">{verbe.mot}</h3>
          <p class="verbe__texte">{verbe.texte}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ================= CE QUE ÇA PERMET ================= -->
  <section class="section conteneur section--manieres">
    <EnteteSection
      surtitre={t('intentionsSurtitre')}
      titre={t('intentionsTitre')}
    />
    <div class="manieres">
      {/* Format d'origine, aucun recadrage : 2/3, comme la source. Elle
          accompagne le défilement des quatre blocs plutôt que d'être
          posée au-dessus ou en dessous. */}
      <figure class="manieres__visuel tirage">
        <Image
          src={trace}
          alt={t('traceAlt')}
          widths={[300, 460, 620]}
          sizes="(min-width: 52rem) 19rem, 60vw"
          loading="lazy"
        />
      </figure>
      <ul class="manieres__liste">
        {a.manieres.map((maniere, index) => (
          <li class="maniere apparait" style={`--i:${index}`}>
            <span class="trait-croissant maniere__trait" style={`--i:${index}`}></span>
            <h3 class="t-carte maniere__mot">{maniere.titre}</h3>
            <p>{maniere.texte}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= PROCHAINE RENCONTRE ================= -->
  <section class="section conteneur">
    <EnteteSection
      surtitre={t('sectionRencontres')}
      titre={t('accueilRencontresTitre')}
      lien={{ url: chemin(langue, 'evenements'), libelle: t('tousLesEvenements') }}
    ><p class="intro-section">{t('introRencontres')}</p></EnteteSection>
    {prochaine ? (
      <div class="pile pile-6">
        <div class="apparait apparait--image">
          <CarteEvenement evenement={prochaine} variante="mise-en-avant" langue={langue} />
        </div>
        {suivants.length > 0 && (
          <ul class="suite liste-nue">
            {suivants.map((evenement, index) => (
              <li class="apparait apparait--texte" style={`--i:${index}`}>
                <CarteEvenement evenement={evenement} variante="ligne" langue={langue} />
              </li>
            ))}
          </ul>
        )}
      </div>
    ) : (
      <EtatVide titre={t('aucuneRencontreTitre')} texte={t('aucuneRencontreTexte')} />
    )}
  </section>

  <!-- ================= VOIX ================= -->
  {(intervenants.length > 0 || enChantier) && (
  <section class="section conteneur">
    <EnteteSection
      surtitre={t('sectionVoix')}
      titre={t('ceuxQuiParlent')}
      lien={{ url: chemin(langue, 'intervenants'), libelle: t('tousLesIntervenants') }}
    ><p class="intro-section">{t('introVoix')}</p></EnteteSection>
    {/* En dessous de 52rem la rangée défile au doigt plutôt que
        d'empiler quatre portraits sur quatre écrans. */}
    {intervenants.length > 0 ? (
      <ul class="voix liste-nue">
        {enAvant(intervenants, 4).map((intervenant, index) => (
          <li class="apparait apparait--image" style={`--i:${index}`}>
            <CarteIntervenant intervenant={intervenant} langue={langue} />
          </li>
        ))}
      </ul>
    ) : (
      <EtatVide titre={t('aucunIntervenantTitre')} texte={t('aucunIntervenantTexte')} />
    )}
  </section>
  )}

  <!-- ================= PROJETS ================= -->
  {(projets.length > 0 || enChantier) && (
  <section class="section conteneur colonnes">
    <EnteteSection
      surtitre={t('projetsSurtitre')}
      titre={t('projetsTitre')}
      lien={{ url: chemin(langue, 'projets'), libelle: t('tousLesProjets') }}
      class="entete-section--rail"
    ><p class="intro-section">{t('introProjets')}</p></EnteteSection>
    {projets.length > 0 ? (
      <ul class="grille grille--2 liste-nue">
        {enAvant(projets, 3).map((projet, index) => (
          <li class="apparait" style={`--i:${index}`}>
            <CarteProjet projet={projet} langue={langue} />
          </li>
        ))}
      </ul>
    ) : (
      <EtatVide titre={t('aucunProjetTitre')} texte={t('aucunProjetTexte')} />
    )}
  </section>
  )}

  <!-- ================= RÉCITS ================= -->
  {(recits.length > 0 || enChantier) && (
  <section class="section conteneur colonnes colonnes--decale">
    <EnteteSection
      surtitre={t('recitsSurtitre')}
      titre={t('recitsTitre')}
      lien={{ url: chemin(langue, 'recits'), libelle: t('accueilRecitsLien') }}
      class="entete-section--rail"
    ><p class="intro-section">{t('introRecits')}</p></EnteteSection>
    {recits.length > 0 ? (
      <ul class="grille grille--2 liste-nue">
        {enAvant(recits, 3).map((recit, index) => (
          <li class="apparait" style={`--i:${index}`}>
            <CarteRecit recit={recit} langue={langue} />
          </li>
        ))}
      </ul>
    ) : (
      <EtatVide titre={t('aucunRecitTitre')} texte={t('aucunRecitTexte')} />
    )}
  </section>
  )}

  <!-- ================= ÉCOSYSTÈME =================
       Pas de page à lui : l'entrée du menu et les boutons « rejoindre »
       mènent ici. L'ancre est traduite comme le reste des adresses. -->
  <section class="section scene ecosysteme" id={ancreEcosysteme[langue]}>
    <div class="conteneur ecosysteme__interieur">
      <div>
        <EnteteSection surtitre={a.ecosysteme.surtitre} titre={a.ecosysteme.titre} />
        <p class="ecosysteme__texte">{a.ecosysteme.texte}</p>
      </div>
      <div class="ecosysteme__suite">
        <p class="ecosysteme__phrase">{a.ecosysteme.phrase}</p>
        <a href={lienEcosysteme} class="bouton">{a.ecosysteme.bouton}</a>
      </div>
    </div>
  </section>

  <BandeauCta
    surtitre={t('ctaAporterSurtitre')}
    titre={t('ctaAporterTitre')}
    texte={t('ctaAporterTexte')}
    actions={[
      { url: chemin(langue, 'engagement'), libelle: t('ctaCommentParticiper') },
      { url: chemin(langue, 'contact'), libelle: t('ctaContacter'), variante: 'fantome' },
    ]}
  />
</Base>

<style>
  /* ---------------- Héros ---------------- */
  .heros {
    position: relative;
    /* Le visuel déborde sur la section suivante : rien à rogner en bas. */
    overflow: clip visible;
    border-bottom: 1px solid var(--trait);
  }

  /* Le trait continu du logo, déplié à travers le héros. */
  /* `preserveAspectRatio: none` étire la courbe à la hauteur du bloc :
     sur un héros étroit et haut elle devient une quasi-verticale qui
     traverse le titre, et ne se lit plus comme le trait du logo. Elle
     n'apparaît qu'à partir du moment où le héros est assez large. */
  .heros__trait { display: none; }
  @media (min-width: 52rem) {
    .heros__trait { display: block; }
  }
  .heros__trait {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--or);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.16;
    pointer-events: none;
  }

  .heros__interieur {
    position: relative;
    display: grid;
    gap: var(--e-8);
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3rem, 7vw, 6rem);
    align-items: center;
  }

  .heros__texte { display: flex; flex-direction: column; align-items: flex-start; position: relative; }
  /* Halo ocre derrière le titre : le fond profond gagne un centre. */
  .heros__texte::before {
    content: '';
    position: absolute;
    inset: -30% -20% 20% -25%;
    background: radial-gradient(closest-side, var(--halo), transparent 72%);
    pointer-events: none;
  }
  .heros__surtitre, .heros__titre, .heros__chapo, .heros__actions, .heros__reperes { position: relative; }

  /* ---- Les trois verbes ----
     Ils portent le même poids : aucun n'est l'accent de l'autre, et
     c'est l'empilement qui fait la composition. Les capitales demandent
     de rendre l'approche que `.t-hero` serre pour du bas-de-casse. */
  .heros__titre {
    margin-bottom: var(--e-5);
    display: flex;
    flex-direction: column;
    gap: var(--e-1, 0.25rem);
    text-transform: uppercase;
    letter-spacing: -0.015em;
  }
  .heros__mot { display: flex; align-items: center; gap: var(--e-4); }
  .heros__verbe { display: block; }
  .heros__point { color: var(--or); font-weight: 400; }

  .heros__chapo { margin-bottom: var(--e-6); }
  .heros__actions { gap: var(--e-3); }

  /* Trois données réelles sous les boutons : une raison de descendre. */
  /* Quatre données sur une rangée. Les points médians d'avant ne
     survivaient pas au retour à la ligne : le séparateur restait
     orphelin en fin ou en début de ligne, à trois largeurs sur quatre.
     L'écart les sépare aussi bien, et il se replie proprement. Le filet
     du dessus tient déjà le bloc ensemble. */
  .heros__reperes {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--e-5);
    row-gap: var(--e-2);
    margin-top: var(--e-5);
    padding-top: var(--e-4);
    border-top: 1px solid var(--trait);
    font-family: var(--f-titre);
    font-size: var(--t-300);
    font-variant-numeric: tabular-nums;
    color: var(--encre-douce);
  }
  /* Chaque donnée reste d'un seul tenant : la rangée casse entre elles,
     jamais au milieu de « Entrada libre y gratuita ». */
  .heros__repere { white-space: nowrap; }

  .heros__visuel {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-visuel);
    background: var(--surface);
    /* Portrait 4/5, comme les fiches d'intervenants : le site a déjà
       ce format dans son vocabulaire, l'image n'arrive pas en corps
       étranger. Le 3/2 d'avant rognait plus de la moitié de la hauteur
       d'une photo verticale. */
    aspect-ratio: 4 / 5;
  }
  .heros__visuel :global(img) { width: 100%; height: 100%; object-fit: cover; }

  @media (min-width: 62rem) {
    /* La seconde colonne n'existe que s'il y a un visuel. */
    .heros__interieur:has(.heros__visuel) {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      gap: var(--e-9);
    }
    /* Le visuel descend sur la section suivante, qui lui fait la place. */
    .heros__visuel { margin-bottom: -4rem; }
    .section--apres-heros { padding-top: clamp(5rem, 9vw, 9rem); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .heros__surtitre, .heros__titre, .heros__chapo, .heros__actions, .heros__reperes, .heros__visuel {
      animation: heros-entree var(--mv-lent) var(--courbe-arrivee) both;
    }
    .heros__titre { animation-delay: 60ms; }
    .heros__chapo { animation-delay: 120ms; }
    .heros__actions { animation-delay: 180ms; }
    .heros__reperes { animation-delay: 240ms; }
    .heros__visuel { animation-delay: 120ms; }
    @keyframes heros-entree { from { opacity: 0; transform: translateY(14px); } }

    /* Parallaxe : lié à la position du visuel dans l'écran, sans écouter
       le défilement. Là où la règle est inconnue, l'image ne bouge pas. */
    @supports (animation-timeline: view()) {
      .heros__visuel :global(img) {
        animation: heros-derive linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      @keyframes heros-derive {
        from { transform: translateY(-20px) scale(1.08); }
        to { transform: translateY(20px) scale(1.08); }
      }
    }
  }

  /* ---------------- Le constat ---------------- */
  .constat { display: grid; gap: var(--e-6); }
  @media (min-width: 60rem) {
    .constat {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: var(--e-8);
      align-items: start;
    }
    .constat__phrase { grid-column: 1 / -1; }
  }
  /* L'énumération est le sujet de la section : elle se lit comme une
     liste posée, pas comme une phrase. */
  .constat__enumeration {
    font-family: var(--f-titre);
    font-size: var(--t-500);
    font-weight: 600;
    line-height: 1.5;
    color: var(--encre);
    text-wrap: balance;
  }
  .constat__corps {
    font-size: var(--t-400);
    line-height: 1.7;
    color: var(--encre-douce);
    max-width: var(--largeur-texte);
    text-wrap: pretty;
  }
  .constat__phrase {
    font-family: var(--f-lecture);
    font-style: italic;
    font-size: var(--t-600);
    line-height: 1.45;
    color: var(--encre);
    max-width: 38ch;
    border-left: var(--epaisseur-trait) solid var(--or);
    padding-left: var(--e-5);
    margin-top: var(--e-4);
    text-wrap: pretty;
  }

  /* ---------------- Les trois verbes ----------------
     Même composition que la boussole de la page Association : c'est le
     même propos, il n'a pas de raison de changer de forme d'une page à
     l'autre. */
  .verbes {
    display: grid;
    gap: var(--e-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 48rem) {
    .verbes { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--e-5); }
  }
  .verbe { display: flex; flex-direction: column; gap: var(--e-2); }
  .verbe__trait { max-width: 6rem; margin-bottom: var(--e-3); }
  .verbe__rang {
    font-family: var(--f-titre);
    font-size: var(--t-100);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--or-encre);
    font-variant-numeric: tabular-nums;
  }
  .verbe__mot {
    font-family: var(--f-titre);
    font-size: var(--t-700);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--terre);
  }
  .verbe__texte { font-size: var(--t-300); line-height: 1.65; color: var(--encre-douce); text-wrap: pretty; }

  /* ---------------- Les quatre manières ---------------- */
  /* Mosaïque : 5/4 puis 4/5, sur les neuf colonnes qui restent à droite
     de l'image. La rupture de rythme suffit — quatre blocs de largeur
     égale se lisent comme un tableau, pas comme un propos. */
  .manieres { display: grid; gap: var(--e-7); }
  .manieres__liste { display: grid; gap: var(--e-7) var(--e-8); list-style: none; margin: 0; padding: 0; }
  .manieres__visuel {
    margin: 0;
    overflow: hidden;
    border-radius: var(--r-visuel);
    background: var(--surface-2);
    /* Ratio de la source : elle n'est jamais recadrée. */
    aspect-ratio: 2 / 3;
    max-width: 19rem;
  }
  .manieres__visuel :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }

  @media (min-width: 52rem) {
    .manieres { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--e-8); align-items: start; }
    /* L'image accompagne les deux rangées de blocs sans les suivre. */
    .manieres__visuel { position: sticky; top: 7rem; }
