---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import CarteEvenement from '~/components/CarteEvenement.astro';
import CarteIntervenant from '~/components/CarteIntervenant.astro';
import CarteProjet from '~/components/CarteProjet.astro';
import CarteRecit from '~/components/CarteRecit.astro';
import BandeauCta from '~/components/BandeauCta.astro';
import EtatVide from '~/components/EtatVide.astro';
import site from '~/data/site.json';
import { champ } from '~/i18n/site';
import {
  chargerEvenements,
  chargerIntervenants,
  chargerProjets,
  chargerRecits,
  enChantier,
} from '~/lib/contenu';
import { formaterDate } from '~/i18n/utils';
import { chemin, type Langue } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';
import { intentionsPar } from '~/i18n/intentions';

/* Photo d'ouverture : aucune pour l'instant. Le héros se replie alors
   sur une seule colonne plutôt que d'afficher un cadre vide.
   Pour en remettre une, deux lignes :
     import ouverture from '~/assets/uploads/nom-du-fichier.jpg';
   puis remplacer `null` ci-dessous par `ouverture`. */
const ouverture = null;

interface Props { langue: Langue; alternatives: Record<Langue, string> }
const { langue, alternatives } = Astro.props;
const t = traducteur(langue);

const { aVenir } = await chargerEvenements(langue);
const intervenants = await chargerIntervenants(langue);
const projets = await chargerProjets(langue);
const recits = await chargerRecits(langue);

const prochaine = aVenir[0];
const suivants = aVenir.slice(1, 4);

const enAvant = <T extends { data: { en_avant: boolean } }>(liste: T[], nombre: number) => {
  const mis = liste.filter((e) => e.data.en_avant);
  return (mis.length ? mis : liste).slice(0, nombre);
};

const intentions = intentionsPar[langue];

/* Ligne de données du héros : la date, le lieu et le tarif de la
   prochaine rencontre. Trois informations réelles, ou rien. */
const reperes = prochaine
  ? [
      formaterDate(prochaine.data.date_debut, langue, { day: 'numeric', month: 'long' }),
      prochaine.data.lieu?.ville,
      prochaine.data.tarif,
    ].filter(Boolean)
  : [];

const titreProchaine = prochaine
  ? t('prochaineRencontreLe').replace(
      '{date}',
      formaterDate(prochaine.data.date_debut, langue, { day: 'numeric', month: 'long' }),
    )
  : t('prochaineRencontre');
---

<Base
  titre={site.nom}
  description={champ(site.description_courte, langue)}
  langue={langue}
  alternatives={alternatives}
>
  <!-- ================= HÉROS ================= -->
  <section class="heros scene">
    <svg class="heros__trait" viewBox="0 0 1200 400" aria-hidden="true" preserveAspectRatio="none">
      <path d="M-40 330 C 180 330 200 90 400 90 C 600 90 620 310 820 310 C 1020 310 1040 120 1260 120" />
    </svg>

    <div class="conteneur heros__interieur">
      <div class="heros__texte">
        <p class="surtitre heros__surtitre">{t('heroSurtitre')}</p>
        <h1 class="t-hero heros__titre">
          <span class="heros__phrase">{t('heroTitreA')}</span>
          <span class="heros__phrase heros__phrase--fort">{t('heroTitreB')}</span>
        </h1>
        <p class="chapo heros__chapo">{t('heroChapo')}</p>
        <div class="rang heros__actions">
          <a href={chemin(langue, 'evenements')} class="bouton">
            {prochaine ? t('heroBoutonProchain') : t('heroBoutonEvenements')}
          </a>
          <a href={chemin(langue, 'association')} class="bouton bouton--fantome">{t('heroBoutonAssociation')}</a>
        </div>

        {reperes.length > 0 && (
          <p class="heros__reperes">
            {reperes.map((repere, index) => (
              <>{index > 0 && <span aria-hidden="true"> · </span>}<span class="heros__repere">{repere}</span></>
            ))}
          </p>
        )}
      </div>

      {ouverture && (
        <div class="heros__visuel tirage">
          <Image
            src={ouverture}
            alt={t('ouvertureAlt')}
            widths={[420, 700, 1000]}
            sizes="(min-width: 62rem) 32rem, 92vw"
            loading="eager"
          />
        </div>
      )}
    </div>
  </section>

  <!-- ================= INTENTIONS ================= -->
  <section class="section conteneur section--intentions">
    <EnteteSection
      surtitre={t('intentionsSurtitre')}
      titre={t('intentionsTitre')}
    />
    <ul class="intentions">
      {intentions.map((intention, index) => (
        <li class="intention apparait" style={`--i:${index}`}>
          <span class="trait-croissant intention__trait" style={`--i:${index}`}></span>
          <h3 class="t-carte intention__mot">{intention.titre}</h3>
          <p>{intention.texte}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ================= PROCHAINE RENCONTRE ================= -->
  <section class="section conteneur">
    <EnteteSection
      surtitre={t('sectionRencontres')}
      titre={titreProchaine}
      lien={{ url: chemin(langue, 'evenements'), libelle: t('tousLesEvenements') }}
    ><p class="intro-section">{t('introRencontres')}</p></EnteteSection>
    {prochaine ? (
      <div class="pile pile-6">
        <div class="apparait apparait--image">
          <CarteEvenement evenement={prochaine} variante="mise-en-avant" langue={langue} />
        </div>
        {suivants.length > 0 && (
          <ul class="suite liste-nue">
            {suivants.map((evenement, index) => (
              <li class="apparait apparait--texte" style={`--i:${index}`}>
                <CarteEvenement evenement={evenement} variante="ligne" langue={langue} />
              </li>
            ))}
          </ul>
        )}
      </div>
    ) : (
      <EtatVide titre={t('aucuneRencontreTitre')} texte={t('aucuneRencontreTexte')} />
    )}
  </section>

  <!-- ================= INTERVENANTS ================= -->
  {(intervenants.length > 0 || enChantier) && (
  <section class="section conteneur">
    <EnteteSection
      surtitre={t('sectionVoix')}
      titre={t('ceuxQuiParlent')}
      lien={{ url: chemin(langue, 'intervenants'), libelle: t('tousLesIntervenants') }}
    ><p class="intro-section">{t('introVoix')}</p></EnteteSection>
    {/* En dessous de 52rem la rangée défile au doigt plutôt que
        d'empiler quatre portraits sur quatre écrans. */}
    {intervenants.length > 0 ? (
      <ul class="voix liste-nue">
        {enAvant(intervenants, 4).map((intervenant, index) => (
          <li class="apparait apparait--image" style={`--i:${index}`}>
            <CarteIntervenant intervenant={intervenant} langue={langue} />
          </li>
        ))}
      </ul>
    ) : (
      <EtatVide titre={t('aucunIntervenantTitre')} texte={t('aucunIntervenantTexte')} />
    )}
  </section>
  )}

  <!-- ================= PROJETS ================= -->
  {(projets.length > 0 || enChantier) && (
  <section class="section conteneur colonnes">
    <EnteteSection
      surtitre={t('navProjets')}
      titre={t('ceQueLAssociationConstruit')}
      lien={{ url: chemin(langue, 'projets'), libelle: t('tousLesProjets') }}
      class="entete-section--rail"
    ><p class="intro-section">{t('introProjets')}</p></EnteteSection>
    {projets.length > 0 ? (
      <ul class="grille grille--2 liste-nue">
        {enAvant(projets, 3).map((projet, index) => (
          <li class="apparait" style={`--i:${index}`}>
            <CarteProjet projet={projet} langue={langue} />
          </li>
        ))}
      </ul>
    ) : (
      <EtatVide titre={t('aucunProjetTitre')} texte={t('aucunProjetTexte')} />
    )}
  </section>
  )}

  <!-- ================= RÉCITS ================= -->
  {(recits.length > 0 || enChantier) && (
  <section class="section conteneur colonnes colonnes--decale">
    <EnteteSection
      surtitre={t('navRecits')}
      titre={t('portraitsRetoursIdees')}
      lien={{ url: chemin(langue, 'recits'), libelle: t('tousLesRecits') }}
      class="entete-section--rail"
    ><p class="intro-section">{t('introRecits')}</p></EnteteSection>
    {recits.length > 0 ? (
      <ul class="grille grille--2 liste-nue">
        {enAvant(recits, 3).map((recit, index) => (
          <li class="apparait" style={`--i:${index}`}>
            <CarteRecit recit={recit} langue={langue} />
          </li>
        ))}
      </ul>
    ) : (
      <EtatVide titre={t('aucunRecitTitre')} texte={t('aucunRecitTexte')} />
    )}
  </section>
  )}

  <BandeauCta
    surtitre={t('ctaParticiperSurtitre')}
    titre={t('ctaParticiperTitre')}
    texte={t('ctaParticiperTexte')}
    actions={[
      { url: chemin(langue, 'engagement'), libelle: t('ctaVoirEngagement') },
      { url: chemin(langue, 'contact'), libelle: t('ctaNousEcrire'), variante: 'fantome' },
    ]}
  />
</Base>

<style>
  /* ---------------- Héros ---------------- */
  .heros {
    position: relative;
    /* Le visuel déborde sur la section suivante : rien à rogner en bas. */
    overflow: clip visible;
    border-bottom: 1px solid var(--trait);
  }

  /* Le trait continu du logo, déplié à travers le héros. */
  /* `preserveAspectRatio: none` étire la courbe à la hauteur du bloc :
     sur un héros étroit et haut elle devient une quasi-verticale qui
     traverse le titre, et ne se lit plus comme le trait du logo. Elle
     n'apparaît qu'à partir du moment où le héros est assez large. */
  .heros__trait { display: none; }
  @media (min-width: 52rem) {
    .heros__trait { display: block; }
  }
  .heros__trait {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--or);
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.16;
    pointer-events: none;
  }

  .heros__interieur {
    position: relative;
    display: grid;
    gap: var(--e-8);
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3rem, 7vw, 6rem);
    align-items: center;
  }

  .heros__texte { display: flex; flex-direction: column; align-items: flex-start; position: relative; }
  /* Halo ocre derrière le titre : le fond profond gagne un centre. */
  .heros__texte::before {
    content: '';
    position: absolute;
    inset: -30% -20% 20% -25%;
    background: radial-gradient(closest-side, var(--halo), transparent 72%);
    pointer-events: none;
  }
  .heros__surtitre, .heros__titre, .heros__chapo, .heros__actions, .heros__reperes { position: relative; }

  .heros__titre { margin-bottom: var(--e-5); max-width: 17ch; }
  /* Les deux phrases s'empilent toujours : c'est l'antithèse qui porte
     le titre, et elle ne se lit que si les deux moitiés sont parallèles.
     L'accent est un poids, pas une couleur — la terracotta reste à
     l'action, c'est-à-dire au bouton juste en dessous. */
  .heros__phrase { display: block; text-wrap: balance; color: var(--encre-douce); }
  .heros__phrase--fort { font-weight: 800; color: var(--encre); }
  .heros__chapo { margin-bottom: var(--e-6); }
  .heros__actions { gap: var(--e-3); }

  /* Trois données réelles sous les boutons : une raison de descendre. */
  .heros__reperes {
    margin-top: var(--e-5);
    padding-top: var(--e-4);
    border-top: 1px solid var(--trait);
    font-family: var(--f-titre);
    font-size: var(--t-300);
    font-variant-numeric: tabular-nums;
    color: var(--encre-douce);
  }
  /* Chaque donnée reste d'un seul tenant : la ligne casse entre elles,
     jamais au milieu de « Entrada libre y gratuita ». Le séparateur, lui,
     garde ses espaces sécables — sinon la ligne n'aurait plus où casser. */
  .heros__repere { white-space: nowrap; }

  .heros__visuel {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-visuel);
    background: var(--surface);
    aspect-ratio: 3 / 2;
  }
  .heros__visuel :global(img) { width: 100%; height: 100%; object-fit: cover; }

  @media (min-width: 62rem) {
    /* La seconde colonne n'existe que s'il y a un visuel. */
    .heros__interieur:has(.heros__visuel) {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
      gap: var(--e-9);
    }
    /* Le visuel descend sur la section suivante. */
    .heros__visuel { margin-bottom: -4rem; }
    .section--intentions { padding-top: clamp(5rem, 9vw, 9rem); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .heros__surtitre, .heros__titre, .heros__chapo, .heros__actions, .heros__reperes, .heros__visuel {
      animation: heros-entree var(--mv-lent) var(--courbe-arrivee) both;
    }
    .heros__titre { animation-delay: 60ms; }
    .heros__chapo { animation-delay: 120ms; }
    .heros__actions { animation-delay: 180ms; }
    .heros__reperes { animation-delay: 240ms; }
    .heros__visuel { animation-delay: 120ms; }
    @keyframes heros-entree { from { opacity: 0; transform: translateY(14px); } }

    /* Parallaxe : lié à la position du visuel dans l'écran, sans écouter
       le défilement. Là où la règle est inconnue, l'image ne bouge pas. */
    @supports (animation-timeline: view()) {
      .heros__visuel :global(img) {
        animation: heros-derive linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
      @keyframes heros-derive {
        from { transform: translateY(-20px) scale(1.08); }
        to { transform: translateY(20px) scale(1.08); }
      }
    }
  }

  /* ---------------- Intentions ---------------- */
  /* Mosaïque : 7/5 puis 5/7. La rupture de rythme suffit — quatre blocs
     de largeur égale se lisent comme un tableau, pas comme un propos. */
  .intentions { display: grid; gap: var(--e-7) var(--e-8); }
  @media (min-width: 52rem) {
    .intentions { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .intention:nth-child(1) { grid-column: 1 / 8; }
    .intention:nth-child(2) { grid-column: 8 / -1; }
    .intention:nth-child(3) { grid-column: 1 / 6; }
    .intention:nth-child(4) { grid-column: 6 / -1; }
  }
  .intention { display: flex; flex-direction: column; gap: var(--e-3); }
  .intention__trait { max-width: 6rem; }
  .intention__mot { font-weight: 700; }
  .intention p { font-size: var(--t-300); line-height: 1.65; color: var(--encre-douce); text-wrap: pretty; }

  /* ---------------- Rencontres suivantes ---------------- */
  .suite { display: flex; flex-direction: column; }
  .suite li { border-top: 1px solid var(--trait); padding-block: var(--e-4); }
  .suite li:last-child { border-bottom: 1px solid var(--trait); }

  /* ---------------- Voix ---------------- */
  .voix { display: grid; gap: var(--e-6); }
  @media (max-width: 51.99rem) {
    .voix {
      grid-auto-flow: column;
      grid-auto-columns: 68vw;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      /* La rangée déborde des marges du conteneur, comme un rayon. */
      margin-inline: calc(var(--gouttiere) * -1);
      padding-inline: var(--gouttiere);
      padding-bottom: var(--e-3);
      scrollbar-width: thin;
    }
    .voix > li { scroll-snap-align: start; }
  }
  @media (min-width: 52rem) {
    .voix { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* ---------------- Rails de section ---------------- */
  @media (min-width: 60rem) {
    .colonnes :global(.entete-section--rail) {
      display: block;
      margin-bottom: 0;
      position: sticky;
      top: 7rem;
    }
    .colonnes :global(.entete-section--rail .lien-suite) { margin-top: var(--e-4); }
  }
</style>
