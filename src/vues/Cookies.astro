---
import Base from '~/layouts/Base.astro';
import CookiesEs from './textes/CookiesEs.astro';
import CookiesFr from './textes/CookiesFr.astro';
import CookiesEn from './textes/CookiesEn.astro';
import CookiesCa from './textes/CookiesCa.astro';
import type { Langue } from '~/i18n/config';

interface Props { langue: Langue; alternatives: Record<Langue, string> }
const { langue, alternatives } = Astro.props;

const meta = {
  es: {
    titre: 'Cookies',
    description: 'Esta web no deposita ninguna cookie. Esta página explica qué se guarda en tu dispositivo, por qué, y cómo borrarlo.',
  },
  fr: {
    titre: 'Cookies',
    description: "Ce site ne dépose aucun cookie. Cette page explique ce qui est stocké sur votre appareil, pourquoi, et comment le supprimer.",
  },
  en: {
    titre: 'Cookies',
    description: 'This site sets no cookies. This page explains what is stored on your device, why, and how to delete it.',
  },
  ca: {
    titre: 'Galetes',
    description: 'Aquest web no diposita cap galeta. Aquesta pàgina explica què es guarda al teu dispositiu, per què, i com esborrar-ho.',
  },
} as const;
const { titre, description } = meta[langue];
---
<Base titre={titre} description={description} langue={langue} alternatives={alternatives}>
  {langue === 'es' && <CookiesEs />}
  {langue === 'fr' && <CookiesFr />}
  {langue === 'en' && <CookiesEn />}
  {langue === 'ca' && <CookiesCa />}
</Base>
