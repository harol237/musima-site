---
import { getEntries, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import FilDAriane from '~/components/FilDAriane.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import CarteRecit from '~/components/CarteRecit.astro';
import CarteIntervenant from '~/components/CarteIntervenant.astro';
import ARemplir from '~/components/ARemplir.astro';
import VisuelDeSecours from '~/components/VisuelDeSecours.astro';
import { estPublie, dateISO, chargerRecits, pret, slugDe } from '~/lib/contenu';
import { nomTransition } from '~/lib/transitions';
import { formaterDate } from '~/i18n/utils';
import { chemin, type Langue } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';

interface Props {
  langue: Langue;
  alternatives: Record<Langue, string>;
  recit: CollectionEntry<'recits'>;
}
const { recit, langue, alternatives } = Astro.props;
const t = traducteur(langue);
const { data } = recit;
const { Content } = await render(recit);
const intervenants = data.intervenants.length ? await getEntries(data.intervenants) : [];

const tous = await chargerRecits(langue);
const aLire = tous.filter((r) => r.id !== recit.id).slice(0, 2);

const donnees = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.titre,
  datePublished: data.date.toISOString(),
  ...(data.auteur ? { author: { '@type': 'Person', name: data.auteur } } : {}),
  publisher: { '@type': 'Organization', name: 'MUSIMA' },
  ...(data.resume ? { description: data.resume } : {}),
};
---

<Base
  titre={data.meta_titre ?? data.titre}
  description={data.meta_description ?? data.resume}
  type="article"
  publieLe={data.date}
  noindex={data.modele}
  langue={langue}
  alternatives={alternatives}
>
  {/* Barre de progression : pilotée par le défilement du document,
      sans écouteur. Elle n'apparaît que sur les pages de lecture. */}
  <div class="progression" aria-hidden="true"></div>

  <article>
    <header class="entete-recit">
      <div class="conteneur conteneur--etroit pile pile-4">
        <FilDAriane elements={[{ libelle: t('navRecits'), url: chemin(langue, 'recits') }, { libelle: data.titre }]} />
        {data.modele && <p class="rappel-modele">{t('ficheModele')}</p>}
        <div class="rang">
          <span class="puce puce--sourde">{data.categorie}</span>
          <time class="meta" datetime={dateISO(data.date)}>{formaterDate(data.date, langue)}</time>
          {data.temps_lecture && <span class="meta">· {data.temps_lecture}</span>}
        </div>
        <h1 class="t-page">{data.titre}</h1>
        {data.resume && <p class="chapo">{data.resume}</p>}
        <p class="meta">{t('parAuteur')} {data.auteur ?? 'MUSIMA'}</p>
      </div>
    </header>

    <div class="conteneur conteneur--etroit">
      <figure class="visuel-principal">
        <div class="ratio-16-9 visuel-principal__cadre tirage" style={nomTransition('rc', slugDe(recit.id), !!data.image)}>
          {data.image ? (
            <Image src={data.image} alt={pret(data.image_alt) ?? ''} widths={[640, 1000, 1400]} sizes="(min-width: 56rem) 52rem, 100vw" />
          ) : (
            <>
              <VisuelDeSecours variante="titre" texte={data.titre} graine={recit.id} />
              <ARemplir type="photo" forme="visuel" class="par-dessus" />
            </>
          )}
        </div>
        {pret(data.credit_photo) && <figcaption>{t('photoCredit')} : {data.credit_photo}</figcaption>}
      </figure>

      <div class="prose corps-recit"><Content /></div>

      {data.mots_cles.length > 0 && (
        <ul class="mots-cles">
          {data.mots_cles.map((mot) => <li><span class="puce puce--sourde">{mot}</span></li>)}
        </ul>
      )}
    </div>
  </article>

  {intervenants.length > 0 && (
    <section class="section conteneur">
      <EnteteSection surtitre={t('dansCeRecit')} titre={t('personnesCitees')} />
      <ul class="grille grille--3 liste-nue">
        {intervenants.map((intervenant, index) => (
          <li class="apparait apparait--image" style={`--i:${index}`}>
            <CarteIntervenant intervenant={intervenant} langue={langue} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {aLire.length > 0 && (
    <section class="section conteneur">
      <EnteteSection
        surtitre={t('aLireEnsuite')}
        titre={t('autresRecits')}
        lien={{ url: chemin(langue, 'recits'), libelle: t('tousLesRecits') }}
      />
      <ul class="grille grille--2 liste-nue">
        {aLire.map((autre, index) => (
          <li class="apparait" style={`--i:${index}`}><CarteRecit recit={autre} langue={langue} /></li>
        ))}
      </ul>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(donnees)} is:inline />
</Base>

<style>
  .progression {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--epaisseur-trait);
    background: var(--or);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 55;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .progression {
        animation: lecture linear both;
        animation-timeline: scroll();
      }
      @keyframes lecture { to { transform: scaleX(1); } }
    }
  }

  .entete-recit { padding-block: var(--e-6) var(--e-7); border-bottom: 1px solid var(--trait); margin-bottom: var(--e-7); }
  .entete-recit .meta { font-variant-numeric: tabular-nums; }
  .entete-recit .pile { align-items: flex-start; }

  .visuel-principal { margin: 0 0 var(--e-8); }
  .visuel-principal__cadre { border-radius: var(--r-image); overflow: hidden; background: var(--surface-2); }
  .visuel-principal__cadre :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .visuel-principal figcaption { font-family: var(--f-titre); font-size: var(--t-100); color: var(--encre-faible); margin-top: var(--e-2); }

  .corps-recit { margin-inline: auto; }
  /* Lettrine : le geste qui sépare un article composé d'un billet. */
  .corps-recit > :global(p:first-of-type::first-letter) {
    float: left;
    font-size: 3.4em;
    line-height: 0.82;
    font-weight: 300;
    padding-right: 0.07em;
    padding-top: 0.04em;
    color: var(--terre);
  }
  /* Les citations débordent la mesure : elles se lisent comme une
     respiration, pas comme un paragraphe de plus. */
  @media (min-width: 56rem) {
    .corps-recit :global(blockquote) {
      margin-left: calc(var(--e-8) * -1);
      padding-left: var(--e-7);
      max-width: calc(var(--largeur-texte) + var(--e-8));
    }
  }
  .mots-cles { display: flex; flex-wrap: wrap; gap: var(--e-2); list-style: none; margin: var(--e-8) auto 0; padding: var(--e-6) 0 0; max-width: var(--largeur-texte); border-top: 1px solid var(--trait); }
  .rappel-modele { font-family: var(--f-titre); font-size: var(--t-200); color: var(--or); }
  .liste-nue { list-style: none; margin: 0; padding: 0; }
</style>
