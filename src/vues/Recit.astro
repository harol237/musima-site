---
import { getCollection, getEntries, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import FilDAriane from '~/components/FilDAriane.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import CarteRecit from '~/components/CarteRecit.astro';
import CarteIntervenant from '~/components/CarteIntervenant.astro';
import ARemplir from '~/components/ARemplir.astro';
import { estPublie, formaterDate, dateISO, chargerRecits, pret } from '~/lib/contenu';

export async function getStaticPaths() {
  const recits = (await getCollection('recits')).filter(estPublie);
  return recits.map((recit) => ({ params: { id: recit.id }, props: { recit } }));
}

const { recit } = Astro.props;
const { data } = recit;
const { Content } = await render(recit);
const intervenants = data.intervenants.length ? await getEntries(data.intervenants) : [];

const tous = await chargerRecits();
const aLire = tous.filter((r) => r.id !== recit.id).slice(0, 2);

const donnees = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.titre,
  datePublished: data.date.toISOString(),
  ...(data.auteur ? { author: { '@type': 'Person', name: data.auteur } } : {}),
  publisher: { '@type': 'Organization', name: 'MUSIMA' },
  ...(data.resume ? { description: data.resume } : {}),
};
---

<Base
  titre={data.meta_titre ?? data.titre}
  description={data.meta_description ?? data.resume}
  type="article"
  publieLe={data.date}
  noindex={data.modele}
>
  <article>
    <header class="entete-recit">
      <div class="conteneur conteneur--etroit pile pile-4">
        <FilDAriane elements={[{ libelle: 'Récits', url: '/recits' }, { libelle: data.titre }]} />
        {data.modele && <p class="rappel-modele">Fiche de démonstration — à remplacer ou supprimer dans le CMS.</p>}
        <div class="rang">
          <span class="puce puce--sourde">{data.categorie}</span>
          <time class="meta" datetime={dateISO(data.date)}>{formaterDate(data.date)}</time>
          {data.temps_lecture && <span class="meta">· {data.temps_lecture}</span>}
        </div>
        <h1 class="t-page">{data.titre}</h1>
        {data.resume && <p class="chapo">{data.resume}</p>}
        <p class="meta">Par {data.auteur ?? 'MUSIMA'}</p>
      </div>
    </header>

    <div class="conteneur conteneur--etroit">
      <figure class="visuel-principal">
        <div class="ratio-16-9 visuel-principal__cadre">
          {data.image ? (
            <Image src={data.image} alt={pret(data.image_alt) ?? ''} widths={[640, 1000, 1400]} sizes="(min-width: 56rem) 52rem, 100vw" />
          ) : (
            <ARemplir type="photo" forme="visuel" />
          )}
        </div>
        {pret(data.credit_photo) && <figcaption>Photo : {data.credit_photo}</figcaption>}
      </figure>

      <div class="prose corps-recit"><Content /></div>

      {data.mots_cles.length > 0 && (
        <ul class="mots-cles">
          {data.mots_cles.map((mot) => <li><span class="puce puce--sourde">{mot}</span></li>)}
        </ul>
      )}
    </div>
  </article>

  {intervenants.length > 0 && (
    <section class="section conteneur">
      <EnteteSection surtitre="Dans ce récit" titre="Les personnes citées" />
      <ul class="grille grille--4 liste-nue">
        {intervenants.map((intervenant) => <li><CarteIntervenant intervenant={intervenant} /></li>)}
      </ul>
    </section>
  )}

  {aLire.length > 0 && (
    <section class="section conteneur">
      <EnteteSection surtitre="À lire ensuite" titre="Autres récits" lien={{ url: '/recits', libelle: 'Tous les récits' }} />
      <ul class="grille grille--2 liste-nue">
        {aLire.map((autre) => <li><CarteRecit recit={autre} /></li>)}
      </ul>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(donnees)} is:inline />
</Base>

<style>
  .entete-recit { padding-block: var(--e-6) var(--e-7); border-bottom: 1px solid var(--trait); margin-bottom: var(--e-7); }
  .entete-recit .pile { align-items: flex-start; }

  .visuel-principal { margin: 0 0 var(--e-8); }
  .visuel-principal__cadre { border-radius: var(--r-image); overflow: hidden; background: var(--surface-2); }
  .visuel-principal__cadre :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .visuel-principal figcaption { font-family: var(--f-titre); font-size: var(--t-100); color: var(--encre-faible); margin-top: var(--e-2); }

  .corps-recit { margin-inline: auto; }
  .mots-cles { display: flex; flex-wrap: wrap; gap: var(--e-2); list-style: none; margin: var(--e-8) auto 0; padding: var(--e-6) 0 0; max-width: var(--largeur-texte); border-top: 1px solid var(--trait); }
  .rappel-modele { font-family: var(--f-titre); font-size: var(--t-200); color: var(--or); }
  .liste-nue { list-style: none; margin: 0; padding: 0; }
</style>
