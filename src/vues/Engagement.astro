---
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import ARemplir from '~/components/ARemplir.astro';
import BandeauCta from '~/components/BandeauCta.astro';
import { enChantier } from '~/lib/contenu';
import { chemin, type Langue } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';

interface Props { langue: Langue; alternatives: Record<Langue, string> }
const { langue, alternatives } = Astro.props;
const t = traducteur(langue);

/* Chaque voie porte trois lignes fixes : pour qui, ce que ça implique,
   et ce qu'on fait maintenant. C'est la troisième qui décide — sans
   elle, la page informe sans jamais rien demander.

   `via` règle l'objet du formulaire de contact : une seule porte
   d'entrée pour les quatre voies. */
const textes = {
  es: {
    meta: 'Intervenir, asociarse, echar una mano o acompañar a MUSIMA: las distintas maneras de aportar a la asociación.',
    surtitre: 'Participar',
    titre: 'Hay sitio para ti aquí',
    chapo: 'MUSIMA se construye con quienes hacen. Hay varias maneras de formar parte, según lo que te apetezca aportar.',
    voies: [
      {
        titre: 'Contar lo que has montado',
        pour: 'Tienes una experiencia, un oficio o una trayectoria que compartir.',
        texte: 'MUSIMA invita a personas de todos los ámbitos a contar qué están construyendo — no solo los logros, también los caminos que llevaron hasta ahí.',
        maintenant: 'Escríbenos dos líneas sobre lo que contarías. Con eso basta para empezar a hablar.',
        action: 'Proponer una intervención',
        via: 'intervenir',
      },
      {
        titre: 'Asociarte',
        pour: 'Quieres apoyar el proyecto y formar parte de la aventura.',
        texte: 'La cuota permite que la asociación funcione y da acceso a la vida de MUSIMA: encuentros, intercambios y asamblea general.',
        maintenant: 'La cuota se está fijando. Dinos que te interesa y te avisamos en cuanto esté.',
        action: 'Hacerte socio',
        via: 'adherer',
      },
      {
        titre: 'Echar una mano un sábado',
        pour: 'Quieres aportar algo concreto a la organización.',
        texte: 'Acogida en los encuentros, fotografía, grabación de vídeo, redacción, traducción, comunicación, logística: las necesidades son variadas y cambian con los proyectos.',
        maintenant: 'Cuéntanos qué sabes hacer y cuándo puedes. No hace falta comprometerse a más.',
        action: 'Echar una mano',
        via: 'benevolat',
      },
      {
        titre: 'Acompañar',
        pour: 'Representas a una asociación, una empresa o una institución.',
        texte: 'Ceder un local, apoyar económicamente, coorganizar un encuentro, difundir entre tus públicos: las formas de colaboración se construyen caso por caso.',
        maintenant: 'Escríbenos y lo hablamos. Cada colaboración se define en una conversación.',
        action: 'Colaborar con MUSIMA',
        via: 'partenariat',
      },
    ],
    cadreSurtitre: 'Marco',
    cadreTitre: 'Cuota y afiliación',
    cadreNote: 'El importe de la cuota, las formas de pago y lo que da derecho la afiliación se detallarán aquí. Es la información que tranquiliza a quien descubre la asociación.',
    ctaSurtitre: '¿Alguna duda?',
    ctaTitre: 'Escríbenos, te contestamos',
    ctaTexte: 'Si ninguna de estas formas encaja con lo que tienes en mente, dilo sin más: muchas cosas empiezan por una primera conversación.',
  },
  fr: {
    meta: 'Intervenir, adhérer, donner du temps ou accompagner MUSIMA : les différentes façons de contribuer à l’association.',
    surtitre: 'Participer',
    titre: 'Il y a de la place pour vous ici',
    chapo: 'MUSIMA se construit avec celles et ceux qui font. Il y a plusieurs façons d’en faire partie, selon ce que vous avez envie d’apporter.',
    voies: [
      {
        titre: 'Raconter ce que vous avez monté',
        pour: 'Vous avez une expérience, un savoir-faire ou un parcours à partager.',
        texte: 'MUSIMA invite des personnes de tous les domaines à venir raconter ce qu’elles construisent — pas seulement les réussites, mais aussi les chemins qui ont permis d’y arriver.',
        maintenant: 'Écrivez-nous deux lignes sur ce que vous raconteriez. Ça suffit pour commencer à en parler.',
        action: 'Proposer une intervention',
        via: 'intervenir',
      },
      {
        titre: 'Adhérer',
        pour: 'Vous voulez soutenir la démarche et faire partie de l’aventure.',
        texte: 'L’adhésion permet à l’association de fonctionner et donne accès à la vie de MUSIMA : rencontres, échanges et assemblée générale.',
        maintenant: 'Le montant est en cours de fixation. Dites-nous que ça vous intéresse, on vous prévient dès que c’est arrêté.',
        action: 'Adhérer à l’association',
        via: 'adherer',
      },
      {
        titre: 'Donner un coup de main un samedi',
        pour: 'Vous souhaitez contribuer concrètement à l’organisation.',
        texte: 'Accueil des rencontres, photographie, captation vidéo, rédaction, traduction, communication, logistique : les besoins sont variés et évoluent avec les projets.',
        maintenant: 'Dites-nous ce que vous savez faire et quand vous êtes disponible. Rien de plus à engager.',
        action: 'Devenir bénévole',
        via: 'benevolat',
      },
      {
        titre: 'Accompagner',
        pour: 'Vous représentez une association, une entreprise ou une institution.',
        texte: 'Mise à disposition d’un lieu, soutien financier, co-organisation d’une rencontre, relais auprès de vos publics : les formes de partenariat se construisent au cas par cas.',
        maintenant: 'Écrivez-nous et on en discute. Chaque partenariat se définit dans une conversation.',
        action: 'Devenir partenaire',
        via: 'partenariat',
      },
    ],
    cadreSurtitre: 'Cadre',
    cadreTitre: 'Adhésion et cotisation',
    cadreNote: 'Le montant de la cotisation, les modalités de paiement et les avantages liés à l’adhésion seront précisés ici. Ces informations rassurent les personnes qui découvrent l’association.',
    ctaSurtitre: 'Une question ?',
    ctaTitre: 'Écrivez-nous, on vous répond',
    ctaTexte: 'Si aucune de ces formes ne correspond à ce que vous avez en tête, dites-le simplement — beaucoup de choses se construisent à partir d’une première conversation.',
  },
  en: {
    meta: 'Speaking, joining, lending a hand or backing MUSIMA: the different ways of contributing to the association.',
    surtitre: 'Take part',
    titre: 'There’s a place for you here',
    chapo: 'MUSIMA is built with the people who do things. There are several ways in, depending on what you feel like bringing.',
    voies: [
      {
        titre: 'Tell us what you built',
        pour: 'You have experience, a trade or a path worth sharing.',
        texte: 'MUSIMA invites people from every field to come and say what they are building — not just the wins, but the roads that got them there.',
        maintenant: 'Write us two lines about what you would talk about. That’s enough to start the conversation.',
        action: 'Propose a talk',
        via: 'intervenir',
      },
      {
        titre: 'Become a member',
        pour: 'You want to back the project and be part of it.',
        texte: 'Membership keeps the association running and opens the door to MUSIMA’s life: gatherings, exchanges and the general assembly.',
        maintenant: 'The fee is still being set. Tell us you’re interested and we’ll let you know as soon as it is.',
        action: 'Join the association',
        via: 'adherer',
      },
      {
        titre: 'Lend a hand on a Saturday',
        pour: 'You want to give the organising something concrete.',
        texte: 'Welcoming people at gatherings, photography, filming, writing, translation, communication, logistics: the needs vary and change with the projects.',
        maintenant: 'Tell us what you know how to do and when you’re free. Nothing more to commit to.',
        action: 'Lend a hand',
        via: 'benevolat',
      },
      {
        titre: 'Back us',
        pour: 'You represent an association, a company or an institution.',
        texte: 'Lending a venue, financial support, co-hosting a gathering, passing the word to your audience: partnerships get built case by case.',
        maintenant: 'Write to us and we’ll talk it through. Every partnership is defined in a conversation.',
        action: 'Partner with MUSIMA',
        via: 'partenariat',
      },
    ],
    cadreSurtitre: 'The frame',
    cadreTitre: 'Fee and membership',
    cadreNote: 'The fee, how to pay it and what membership gives you will be set out here. This is the information that reassures someone discovering the association.',
    ctaSurtitre: 'A question?',
    ctaTitre: 'Write to us, we answer',
    ctaTexte: 'If none of these fits what you have in mind, just say so — a lot of things start from a first conversation.',
  },
  ca: {
    meta: 'Intervenir, associar-s’hi, donar un cop de mà o acompanyar MUSIMA: les diferents maneres d’aportar a l’associació.',
    surtitre: 'Participar',
    titre: 'Hi ha lloc per a tu aquí',
    chapo: 'MUSIMA es construeix amb qui fa coses. Hi ha diverses maneres de formar-ne part, segons què tinguis ganes d’aportar.',
    voies: [
      {
        titre: 'Explicar el que has muntat',
        pour: 'Tens una experiència, un ofici o una trajectòria per compartir.',
        texte: 'MUSIMA convida persones de tots els àmbits a explicar què estan construint — no només els encerts, també els camins que hi van portar.',
        maintenant: 'Escriu-nos dues línies sobre què explicaries. Amb això n’hi ha prou per començar a parlar-ne.',
        action: 'Proposar una intervenció',
        via: 'intervenir',
      },
      {
        titre: 'Associar-t’hi',
        pour: 'Vols donar suport al projecte i formar part de l’aventura.',
        texte: 'La quota permet que l’associació funcioni i dona accés a la vida de MUSIMA: trobades, intercanvis i assemblea general.',
        maintenant: 'La quota s’està fixant. Digues-nos que t’interessa i t’avisem quan estigui.',
        action: 'Fer-te’n soci',
        via: 'adherer',
      },
      {
        titre: 'Donar un cop de mà un dissabte',
        pour: 'Vols aportar alguna cosa concreta a l’organització.',
        texte: 'Acollida a les trobades, fotografia, gravació de vídeo, redacció, traducció, comunicació, logística: les necessitats són variades i canvien amb els projectes.',
        maintenant: 'Explica’ns què saps fer i quan pots. No cal comprometre’s a res més.',
        action: 'Donar un cop de mà',
        via: 'benevolat',
      },
      {
        titre: 'Acompanyar',
        pour: 'Representes una associació, una empresa o una institució.',
        texte: 'Cedir un local, donar suport econòmic, coorganitzar una trobada, difondre entre els teus públics: les formes de col·laboració es construeixen cas per cas.',
        maintenant: 'Escriu-nos i ho parlem. Cada col·laboració es defineix en una conversa.',
        action: 'Col·laborar amb MUSIMA',
        via: 'partenariat',
      },
    ],
    cadreSurtitre: 'Marc',
    cadreTitre: 'Quota i afiliació',
    cadreNote: 'L’import de la quota, les formes de pagament i el que dona dret l’afiliació es detallaran aquí. És la informació que tranquil·litza qui descobreix l’associació.',
    ctaSurtitre: 'Algun dubte?',
    ctaTitre: 'Escriu-nos, et contestem',
    ctaTexte: 'Si cap d’aquestes formes encaixa amb el que tens al cap, digues-ho sense més: moltes coses comencen per una primera conversa.',
  },
} as const;
const x = textes[langue];

/* La première voie est celle dont l'association a le plus besoin : elle
   passe en pleine largeur, sur fond profond. La hiérarchie est la
   recommandation — quatre cartes identiques n'en font aucune. */
const [principale, ...secondaires] = x.voies;
const lienVoie = (via: string) => `${chemin(langue, 'contact')}?via=${via}`;
---

<Base
  titre={x.titre}
  description={x.meta}
  langue={langue}
  alternatives={alternatives}
>
  <EntetePage
    surtitre={x.surtitre}
    titre={x.titre}
    chapo={x.chapo}
    ariane={[{ libelle: x.surtitre }]}
    sansFilet
  />

  <section class="scene section--dense principale">
    <div class="conteneur principale__interieur">
      <div class="principale__texte">
        <span class="trait-croissant principale__trait"></span>
        <h2 class="t-section">{principale.titre}</h2>
        <p class="principale__pour">{principale.pour}</p>
        <p class="principale__corps">{principale.texte}</p>
      </div>
      <div class="principale__suite">
        <p class="principale__maintenant">{principale.maintenant}</p>
        <a href={lienVoie(principale.via)} class="bouton">{principale.action}</a>
      </div>
    </div>
  </section>

  <section class="section conteneur">
    <ul class="voies liste-nue">
      {secondaires.map((voie, index) => (
        <li class="voie apparait" style={`--i:${index}`}>
          <div class="voie__entete">
            <span class="voie__trait" aria-hidden="true"></span>
            <h2 class="t-carte">{voie.titre}</h2>
          </div>
          <p class="voie__pour">{voie.pour}</p>
          <p class="voie__texte">{voie.texte}</p>
          <p class="voie__maintenant">{voie.maintenant}</p>
          <a href={lienVoie(voie.via)} class="bouton bouton--fantome voie__action">{voie.action}</a>
        </li>
      ))}
    </ul>
  </section>

  {enChantier && (
  <section class="section conteneur colonnes colonnes--decale">
    <div>
      <EnteteSection surtitre={x.cadreSurtitre} titre={x.cadreTitre} />
    </div>
    <div class="pile pile-4">
      <p class="note">{x.cadreNote}</p>
      <ARemplir libelle="MONTANT DE LA COTISATION À DÉFINIR" />
      <ARemplir libelle="MODALITÉS DE PAIEMENT À DÉFINIR" />
      <ARemplir libelle="BULLETIN D’ADHÉSION (PDF OU FORMULAIRE) À AJOUTER" />
    </div>
  </section>
  )}

  <BandeauCta
    surtitre={x.ctaSurtitre}
    titre={x.ctaTitre}
    texte={x.ctaTexte}
    actions={[{ url: chemin(langue, 'contact'), libelle: t('ctaNousEcrire') }]}
  />
</Base>

<style>
  /* ---------------- Voie principale ---------------- */
  .principale { border-bottom: 1px solid var(--trait); padding-top: 0; }
  .principale__interieur { display: grid; gap: var(--e-6); align-items: end; }
  @media (min-width: 60rem) {
    .principale__interieur {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--e-9);
    }
  }
  .principale__texte { display: flex; flex-direction: column; gap: var(--e-3); }
  .principale__trait { max-width: 4rem; margin-bottom: var(--e-2); }
  .principale__pour { font-family: var(--f-titre); font-size: var(--t-400); font-weight: 600; }
  .principale__corps { color: var(--encre-douce); line-height: 1.65; max-width: 38rem; text-wrap: pretty; }
  .principale__suite { display: flex; flex-direction: column; align-items: flex-start; gap: var(--e-4); }
  .principale__maintenant {
    font-family: var(--f-lecture);
    font-style: italic;
    font-size: var(--t-500);
    line-height: 1.5;
    color: var(--encre);
    border-left: var(--epaisseur-trait) solid var(--or);
    padding-left: var(--e-4);
    text-wrap: pretty;
  }

  /* ---------------- Les trois autres ---------------- */
  .voies { display: grid; gap: var(--e-5); }
  @media (min-width: 60rem) { .voies { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .voie {
    display: flex;
    flex-direction: column;
    gap: var(--e-3);
    padding: var(--e-6);
    border: 1px solid var(--trait);
    border-radius: var(--r-carte);
    background: var(--surface);
    transition: border-color var(--transition),
                box-shadow var(--mv-moyen) var(--courbe-arrivee);
  }
  .voie:has(a:hover), .voie:has(a:focus-visible) {
    border-color: var(--terre);
    box-shadow: var(--ombre-survol);
  }
  .voie__entete { display: flex; align-items: center; gap: var(--e-3); }
  .voie__trait {
    flex: none;
    width: 1.75rem;
    height: var(--epaisseur-trait);
    border-radius: var(--r-pilule);
    background: var(--terre);
    transition: width var(--mv-moyen) var(--courbe-arrivee);
  }
  .voie:has(a:hover) .voie__trait { width: 3.25rem; }
  .voie__pour { font-family: var(--f-titre); font-size: var(--t-300); font-weight: 600; color: var(--encre); }
  .voie__texte { font-size: var(--t-300); color: var(--encre-douce); line-height: 1.65; text-wrap: pretty; }
  .voie__maintenant {
    font-family: var(--f-lecture);
    font-style: italic;
    font-size: var(--t-300);
    line-height: 1.55;
    color: var(--encre);
    border-top: 1px solid var(--trait);
    padding-top: var(--e-3);
    text-wrap: pretty;
  }
  .voie__action { margin-top: auto; align-self: flex-start; }

  .note { font-size: var(--t-300); color: var(--encre-douce); line-height: 1.65; max-width: var(--largeur-texte); }
</style>
