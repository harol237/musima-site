---
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import ARemplir from '~/components/ARemplir.astro';
import BandeauCta from '~/components/BandeauCta.astro';
import { enChantier } from '~/lib/contenu';
import { chemin, type Langue } from '~/i18n/config';
import { parametreMotif, ancreFormulaire } from '~/i18n/formulaire';
import { traducteur } from '~/i18n/ui';

interface Props { langue: Langue; alternatives: Record<Langue, string> }
const { langue, alternatives } = Astro.props;
const t = traducteur(langue);

/* Six voies. Chacune porte deux lignes : à qui elle s'adresse, et ce
   que MUSIMA en fait. La dernière n'a que la première — c'est le texte
   fourni par l'association, on ne lui en invente pas une seconde.

   `via` règle le motif du formulaire de contact : une seule porte
   d'entrée pour les six voies, et chaque motif du formulaire a la
   sienne. */
const textes = {
  es: {
    titreExact: 'Participar en MUSIMA',
    meta: 'Descubre cómo participar, aportar una experiencia, colaborar, apoyar una iniciativa o formar parte del ecosistema MUSIMA.',
    surtitre: 'Participar',
    titre: 'MUSIMA se construye con personas',
    chapo: 'No existe una única manera de formar parte. Puedes compartir lo que sabes, aportar una idea, participar en una actividad, colaborar con un proyecto, apoyar una iniciativa o simplemente conectar con otras personas.',
    voies: [
      {
        titre: 'Compartir una experiencia',
        pour: 'Has construido algo, estás desarrollando un proyecto, tienes un oficio o una experiencia que puede ser útil para otros.',
        suite: 'Queremos escuchar y hacer circular esas experiencias.',
        action: 'Proponer una intervención',
        via: 'intervenir',
      },
      {
        titre: 'Aportar una idea',
        pour: 'Tienes una idea para una actividad, un proyecto, un contenido o una colaboración.',
        suite: 'MUSIMA puede ser el lugar donde esa idea encuentre personas con las que desarrollarse.',
        action: 'Proponer una idea',
        via: 'idea',
      },
      {
        titre: 'Aportar una competencia o recurso',
        pour: 'Puedes aportar una habilidad, conocimiento, contacto, espacio, material u otro recurso.',
        suite: 'A veces una pequeña contribución es suficiente para desbloquear algo.',
        action: 'Quiero aportar',
        via: 'recurso',
      },
      {
        titre: 'Echar una mano en un encuentro',
        pour: 'Quieres estar del otro lado: recibir a las personas, hacer fotos, grabar, escribir, traducir o preparar la sala.',
        suite: 'Los encuentros se sostienen sobre esas manos, y basta con estar disponible un día.',
        action: 'Echar una mano',
        via: 'benevolat',
      },
      {
        titre: 'Colaborar con MUSIMA',
        pour: 'Representas una empresa, asociación, institución, universidad u otro proyecto y ves una posibilidad de colaboración.',
        suite: 'Las colaboraciones se construyen caso por caso, según los objetivos y recursos de cada actor.',
        action: 'Colaborar',
        via: 'partenariat',
      },
      {
        titre: 'Participar en el ecosistema',
        pour: 'Quieres conocer personas, proyectos e iniciativas, descubrir oportunidades, compartir conocimientos y mantenerte conectado a la dinámica MUSIMA.',
        action: 'Reunirme al ecosistema',
        via: 'adherer',
      },
    ],
    cadreSurtitre: 'Marco',
    cadreTitre: 'Cuota y afiliación',
    cadreNote: 'El importe de la cuota, las formas de pago y lo que da derecho la afiliación se detallarán aquí. Es la información que tranquiliza a quien descubre la asociación.',
    ctaSurtitre: 'Construyamos juntos',
    ctaTitre: '¿Qué puedes aportar?',
    ctaTexte: 'Una persona, una idea, una experiencia, una competencia, un contacto, un recurso o un proyecto pueden ser el comienzo de algo nuevo.',
  },
  fr: {
    titreExact: 'Participer à MUSIMA',
    meta: 'Découvre comment participer, apporter une expérience, collaborer, soutenir une initiative ou faire partie de l’écosystème MUSIMA.',
    surtitre: 'Participer',
    titre: 'MUSIMA se construit avec des personnes',
    chapo: 'Il n’y a pas une seule manière d’en faire partie. Tu peux partager ce que tu sais, apporter une idée, participer à une activité, collaborer à un projet, soutenir une initiative, ou simplement rencontrer d’autres personnes.',
    voies: [
      {
        titre: 'Partager une expérience',
        pour: 'Tu as construit quelque chose, tu développes un projet, tu as un métier ou une expérience qui peut être utile à d’autres.',
        suite: 'On veut l’écouter et la faire circuler.',
        action: 'Proposer une intervention',
        via: 'intervenir',
      },
      {
        titre: 'Apporter une idée',
        pour: 'Tu as une idée d’activité, de projet, de contenu ou de collaboration.',
        suite: 'MUSIMA peut être l’endroit où cette idée rencontre les personnes avec qui la développer.',
        action: 'Proposer une idée',
        via: 'idea',
      },
      {
        titre: 'Apporter une compétence ou une ressource',
        pour: 'Tu peux apporter un savoir-faire, une connaissance, un contact, un espace, du matériel ou une autre ressource.',
        suite: 'Parfois, une petite contribution suffit à débloquer quelque chose.',
        action: 'Je veux contribuer',
        via: 'recurso',
      },
      {
        titre: 'Donner un coup de main lors d’une rencontre',
        pour: 'Tu veux être de l’autre côté : accueillir les personnes, photographier, filmer, écrire, traduire ou préparer la salle.',
        suite: 'Les rencontres tiennent sur ces mains-là, et il suffit d’être disponible une journée.',
        action: 'Donner un coup de main',
        via: 'benevolat',
      },
      {
        titre: 'Collaborer avec MUSIMA',
        pour: 'Tu représentes une entreprise, une association, une institution, une université ou un autre projet, et tu vois une possibilité de collaboration.',
        suite: 'Les collaborations se construisent au cas par cas, selon les objectifs et les moyens de chacun.',
        action: 'Collaborer',
        via: 'partenariat',
      },
      {
        titre: 'Participer à l’écosystème',
        pour: 'Tu veux rencontrer des personnes, des projets et des initiatives, découvrir des opportunités, partager des savoirs et rester connecté à la dynamique MUSIMA.',
        action: 'Rejoindre l’écosystème',
        via: 'adherer',
      },
    ],
    cadreSurtitre: 'Cadre',
    cadreTitre: 'Adhésion et cotisation',
    cadreNote: 'Le montant de la cotisation, les modalités de paiement et les avantages liés à l’adhésion seront précisés ici. Ces informations rassurent les personnes qui découvrent l’association.',
    ctaSurtitre: 'Construisons ensemble',
    ctaTitre: 'Qu’est-ce que tu peux apporter ?',
    ctaTexte: 'Une personne, une idée, une expérience, une compétence, un contact, une ressource ou un projet peuvent être le début de quelque chose de nouveau.',
  },
  en: {
    titreExact: 'Take part in MUSIMA',
    meta: 'Find out how to take part, share an experience, collaborate, support an initiative or join the MUSIMA ecosystem.',
    surtitre: 'Take part',
    titre: 'MUSIMA is built with people',
    chapo: 'There isn’t one single way in. You can share what you know, bring an idea, come to an activity, work on a project, support an initiative, or simply connect with other people.',
    voies: [
      {
        titre: 'Share an experience',
        pour: 'You have built something, you are developing a project, you have a trade or an experience that could be useful to others.',
        suite: 'We want to hear it and pass it on.',
        action: 'Propose a talk',
        via: 'intervenir',
      },
      {
        titre: 'Bring an idea',
        pour: 'You have an idea for an activity, a project, a piece of writing or a collaboration.',
        suite: 'MUSIMA can be the place where that idea meets the people to develop it with.',
        action: 'Suggest an idea',
        via: 'idea',
      },
      {
        titre: 'Offer a skill or a resource',
        pour: 'You can offer a skill, some knowledge, a contact, a space, equipment or another resource.',
        suite: 'Sometimes a small contribution is enough to unblock something.',
        action: 'I want to contribute',
        via: 'recurso',
      },
      {
        titre: 'Lend a hand at a gathering',
        pour: 'You want to be on the other side: welcoming people, taking photographs, filming, writing, translating or setting up the room.',
        suite: 'Gatherings rest on those hands, and being free for one day is enough.',
        action: 'Lend a hand',
        via: 'benevolat',
      },
      {
        titre: 'Work with MUSIMA',
        pour: 'You speak for a company, an association, an institution, a university or another project, and you see a possible collaboration.',
        suite: 'Partnerships get built case by case, around each side’s aims and means.',
        action: 'Collaborate',
        via: 'partenariat',
      },
      {
        titre: 'Join the ecosystem',
        pour: 'You want to meet people, projects and initiatives, find opportunities, share knowledge and stay connected to what MUSIMA is doing.',
        action: 'Join the ecosystem',
        via: 'adherer',
      },
    ],
    cadreSurtitre: 'The frame',
    cadreTitre: 'Fee and membership',
    cadreNote: 'The fee, how to pay it and what membership gives you will be set out here. This is the information that reassures someone discovering the association.',
    ctaSurtitre: 'Let’s build together',
    ctaTitre: 'What can you bring?',
    ctaTexte: 'A person, an idea, an experience, a skill, a contact, a resource or a project can be the beginning of something new.',
  },
  ca: {
    titreExact: 'Participar a MUSIMA',
    meta: 'Descobreix com participar, aportar una experiència, col·laborar, donar suport a una iniciativa o formar part de l’ecosistema MUSIMA.',
    surtitre: 'Participar',
    titre: 'MUSIMA es construeix amb persones',
    chapo: 'No hi ha una única manera de formar-ne part. Pots compartir el que saps, aportar una idea, participar en una activitat, col·laborar amb un projecte, donar suport a una iniciativa o simplement connectar amb altres persones.',
    voies: [
      {
        titre: 'Compartir una experiència',
        pour: 'Has construït alguna cosa, estàs desenvolupant un projecte, tens un ofici o una experiència que pot ser útil per a altres.',
        suite: 'Volem escoltar-la i fer-la circular.',
        action: 'Proposar una intervenció',
        via: 'intervenir',
      },
      {
        titre: 'Aportar una idea',
        pour: 'Tens una idea per a una activitat, un projecte, un contingut o una col·laboració.',
        suite: 'MUSIMA pot ser el lloc on aquesta idea trobi persones amb qui desenvolupar-se.',
        action: 'Proposar una idea',
        via: 'idea',
      },
      {
        titre: 'Aportar una competència o recurs',
        pour: 'Pots aportar una habilitat, un coneixement, un contacte, un espai, material o un altre recurs.',
        suite: 'De vegades, una petita contribució ja n’hi ha prou per desbloquejar alguna cosa.',
        action: 'Vull aportar-hi',
        via: 'recurso',
      },
      {
        titre: 'Donar un cop de mà en una trobada',
        pour: 'Vols ser a l’altra banda: rebre les persones, fer fotos, gravar, escriure, traduir o preparar la sala.',
        suite: 'Les trobades se sostenen sobre aquestes mans, i n’hi ha prou amb estar disponible un dia.',
        action: 'Donar un cop de mà',
        via: 'benevolat',
      },
      {
        titre: 'Col·laborar amb MUSIMA',
        pour: 'Representes una empresa, associació, institució, universitat o un altre projecte i veus una possibilitat de col·laboració.',
        suite: 'Les col·laboracions es construeixen cas per cas, segons els objectius i els recursos de cada actor.',
        action: 'Col·laborar',
        via: 'partenariat',
      },
      {
        titre: 'Participar en l’ecosistema',
        pour: 'Vols conèixer persones, projectes i iniciatives, descobrir oportunitats, compartir coneixements i mantenir-te connectat a la dinàmica MUSIMA.',
        action: 'Unir-me a l’ecosistema',
        via: 'adherer',
      },
    ],
    cadreSurtitre: 'Marc',
    cadreTitre: 'Quota i afiliació',
    cadreNote: 'L’import de la quota, les formes de pagament i el que dona dret l’afiliació es detallaran aquí. És la informació que tranquil·litza qui descobreix l’associació.',
    ctaSurtitre: 'Construïm junts',
    ctaTitre: 'Què hi pots aportar?',
    ctaTexte: 'Una persona, una idea, una experiència, una competència, un contacte, un recurs o un projecte poden ser el començament d’alguna cosa nova.',
  },
} as const;
const x = textes[langue];

/* La première voie est celle dont l'association a le plus besoin : elle
   passe en pleine largeur, sur fond profond. La hiérarchie est la
   recommandation — six cartes identiques n'en recommandent aucune. */
const [principale, ...secondaires] = x.voies;
/* Les six parcours de cette page correspondent chacun à un motif du
   formulaire de contact. */
const lienVoie = (via: string) =>
  `${chemin(langue, 'contact')}?${parametreMotif[langue]}=${via}#${ancreFormulaire[langue]}`;
---

<Base
  titre={x.titre}
  titreExact={x.titreExact}
  description={x.meta}
  langue={langue}
  alternatives={alternatives}
>
  <EntetePage
    surtitre={x.surtitre}
    titre={x.titre}
    chapo={x.chapo}
    ariane={[{ libelle: x.surtitre }]}
    sansFilet
  />

  <section class="scene section--dense principale">
    <div class="conteneur principale__interieur">
      <div class="principale__texte">
        <span class="trait-croissant principale__trait"></span>
        <h2 class="t-section">{principale.titre}</h2>
        <p class="principale__pour">{principale.pour}</p>
      </div>
      <div class="principale__suite">
        {'suite' in principale && <p class="principale__phrase">{principale.suite}</p>}
        <a href={lienVoie(principale.via)} class="bouton">{principale.action}</a>
      </div>
    </div>
  </section>

  <section class="section conteneur">
    <ul class="voies liste-nue">
      {secondaires.map((voie, index) => (
        <li
          class:list={['voie', 'apparait', index === secondaires.length - 1 && 'voie--large']}
          style={`--i:${index}`}
        >
          <div class="voie__corps">
            <div class="voie__entete">
              <span class="voie__trait" aria-hidden="true"></span>
              <h2 class="t-carte">{voie.titre}</h2>
            </div>
            <p class="voie__pour">{voie.pour}</p>
            {'suite' in voie && <p class="voie__texte">{voie.suite}</p>}
          </div>
          <a href={lienVoie(voie.via)} class="bouton bouton--fantome voie__action">{voie.action}</a>
        </li>
      ))}
    </ul>
  </section>

  {enChantier && (
  <section class="section conteneur colonnes colonnes--decale">
    <div>
      <EnteteSection surtitre={x.cadreSurtitre} titre={x.cadreTitre} />
    </div>
    <div class="pile pile-4">
      <p class="note">{x.cadreNote}</p>
      <ARemplir libelle="MONTANT DE LA COTISATION À DÉFINIR" />
      <ARemplir libelle="MODALITÉS DE PAIEMENT À DÉFINIR" />
      <ARemplir libelle="BULLETIN D’ADHÉSION (PDF OU FORMULAIRE) À AJOUTER" />
    </div>
  </section>
  )}

  <BandeauCta
    surtitre={x.ctaSurtitre}
    titre={x.ctaTitre}
    texte={x.ctaTexte}
    actions={[{ url: chemin(langue, 'contact'), libelle: t('ctaNousEcrire') }]}
  />
</Base>

<style>
  /* ---------------- Voie principale ---------------- */
  .principale { border-bottom: 1px solid var(--trait); padding-top: 0; }
  .principale__interieur { display: grid; gap: var(--e-6); align-items: end; }
  @media (min-width: 60rem) {
    .principale__interieur {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--e-9);
    }
  }
  .principale__texte { display: flex; flex-direction: column; gap: var(--e-3); }
  .principale__trait { max-width: 4rem; margin-bottom: var(--e-2); }
  .principale__pour {
    font-family: var(--f-titre);
    font-size: var(--t-400);
    font-weight: 600;
    max-width: 38rem;
    text-wrap: pretty;
  }
  .principale__suite { display: flex; flex-direction: column; align-items: flex-start; gap: var(--e-4); }
  .principale__phrase {
    font-family: var(--f-lecture);
    font-style: italic;
    font-size: var(--t-500);
    line-height: 1.5;
    color: var(--encre);
    border-left: var(--epaisseur-trait) solid var(--or);
    padding-left: var(--e-4);
    text-wrap: pretty;
  }

  /* ---------------- Les cinq autres ----------------
     Deux colonnes, et la dernière carte sur toute la largeur : cinq
     cartes ne remplissent ni une grille de deux ni une grille de trois.
     La page s'ouvre sur un bloc large et se referme sur un autre, et la
     voie qui rassemble toutes les autres est celle qui reçoit la plus
     grande carte. */
  .voies { display: grid; gap: var(--e-5); }
  @media (min-width: 52rem) { .voies { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .voie {
    display: flex;
    flex-direction: column;
    gap: var(--e-4);
    padding: var(--e-6);
    border: 1px solid var(--trait);
    border-radius: var(--r-carte);
    background: var(--surface);
    transition: border-color var(--transition),
                box-shadow var(--mv-moyen) var(--courbe-arrivee);
  }
  .voie:has(a:hover), .voie:has(a:focus-visible) {
    border-color: var(--terre);
    box-shadow: var(--ombre-survol);
  }
  .voie__entete { display: flex; align-items: center; gap: var(--e-3); }
  .voie__trait {
    flex: none;
    width: 1.75rem;
    height: var(--epaisseur-trait);
    border-radius: var(--r-pilule);
    background: var(--terre);
    transition: width var(--mv-moyen) var(--courbe-arrivee);
  }
  .voie:has(a:hover) .voie__trait { width: 3.25rem; }
  .voie__pour { font-family: var(--f-titre); font-size: var(--t-300); font-weight: 600; color: var(--encre); }
  .voie__texte { font-size: var(--t-300); color: var(--encre-douce); line-height: 1.65; text-wrap: pretty; }
  .voie__corps { display: flex; flex-direction: column; gap: var(--e-3); flex: 1; }
  .voie__action { align-self: flex-start; }
  /* Placées après `.voie` : à spécificité égale, c'est l'ordre qui
     tranche, et la carte large doit gagner sur la colonne par défaut. */
  @media (min-width: 52rem) {
    .voie--large {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--e-8);
    }
    .voie--large .voie__corps { flex: 0 1 44rem; }
    .voie--large .voie__action { align-self: flex-end; flex: none; }
  }

  .note { font-size: var(--t-300); color: var(--encre-douce); line-height: 1.65; max-width: var(--largeur-texte); }
</style>
