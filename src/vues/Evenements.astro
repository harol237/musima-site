---
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import CarteEvenement from '~/components/CarteEvenement.astro';
import EtatVide from '~/components/EtatVide.astro';
import BandeauCta from '~/components/BandeauCta.astro';
import { chargerEvenements } from '~/lib/contenu';

const { aVenir, passes } = await chargerEvenements();
---

<Base
  titre="Événements"
  description="Les conférences, rencontres, tables rondes et ateliers organisés par MUSIMA : les prochaines dates et les rencontres passées."
>
  <EntetePage
    surtitre="Rencontres"
    titre="Événements"
    chapo="Des conférences et des rencontres où des parcours se racontent, où des savoir-faire se transmettent et où des idées circulent."
    ariane={[{ libelle: 'Événements' }]}
  />

  <section class="section conteneur" id="a-venir">
    <EnteteSection surtitre="À venir" titre={aVenir.length > 1 ? `${aVenir.length} rencontres programmées` : 'Prochaine rencontre'} />
    {aVenir.length > 0 ? (
      <ul class="pile pile-5 liste-nue">
        {aVenir.map((evenement, index) => (
          <li><CarteEvenement evenement={evenement} variante={index === 0 ? 'mise-en-avant' : 'liste'} /></li>
        ))}
      </ul>
    ) : (
      <EtatVide
        titre="Aucune rencontre programmée pour le moment"
        texte="Les prochaines dates seront publiées ici. Pour être prévenu, inscrivez-vous à l’infolettre en bas de page."
      />
    )}
  </section>

  {passes.length > 0 && (
    <section class="section conteneur" id="passes">
      <EnteteSection surtitre="Archives" titre="Rencontres passées" />
      <ul class="grille grille--2 liste-nue">
        {passes.map((evenement) => (
          <li><CarteEvenement evenement={evenement} /></li>
        ))}
      </ul>
    </section>
  )}

  <BandeauCta
    surtitre="Proposer"
    titre="Une intervention, un lieu, un partenariat ?"
    texte="Les rencontres MUSIMA se construisent avec des personnes qui ont une expérience à partager et des lieux qui veulent les accueillir."
    actions={[{ url: '/s-engager', libelle: 'Proposer une intervention' }]}
  />
</Base>

<style>
  .liste-nue { list-style: none; margin: 0; padding: 0; }
</style>
