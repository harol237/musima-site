    surtitre: 'L’association',
    titre: 'Une association. Une vision plus large.',
    missionSurtitre: 'Mission',
    missionTitre: 'Pourquoi MUSIMA existe',
    mission: [
      'Parce que, bien souvent, ce qui peut faire avancer une personne, un projet ou une initiative existe déjà — mais ailleurs, dans un autre réseau ou dans une autre conversation.',
