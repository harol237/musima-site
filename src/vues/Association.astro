---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import BandeauCta from '~/components/BandeauCta.astro';
import ARemplir from '~/components/ARemplir.astro';
import site from '~/data/site.json';
import { champ } from '~/i18n/site';
import { enChantier } from '~/lib/contenu';
import { chemin, type Langue } from '~/i18n/config';

/* Photo de salle, tirée de l'archive 2025 : une seule image dans toute
   la page, posée là où la lecture commence à fatiguer. */
import salle from '~/assets/uploads/galerie-2025/inspire-bcn-5.jpg';
import { traducteur } from '~/i18n/ui';

interface Props { langue: Langue; alternatives: Record<Langue, string> }
const { langue, alternatives } = Astro.props;
const t = traducteur(langue);

/* La page a la même structure dans toutes les langues : seuls les textes
   changent. Un dictionnaire vaut donc mieux ici que deux gabarits, qui
   finiraient par diverger de mise en page. */
const textes = {
  es: {
    meta: 'MUSIMA da luz a personas, trayectorias e iniciativas de africanos que emprenden, crean e innovan. Misión, público, territorio y manera de trabajar.',
    surtitre: 'La asociación',
    titre: 'Por qué montamos esto',
    missionSurtitre: 'Misión',
    missionTitre: 'Por qué existe MUSIMA',
    mission: [
      'No montamos MUSIMA para hablar de los africanos, sino para que hablen ellos y para que lo que dicen no se quede en una cocina.',
      'Lo que nos interesa cabe en una pregunta: ¿cómo lo hiciste? No el resultado, ni la historia bonita que se cuenta después, sino el camino — el dinero que hubo que encontrar, las puertas cerradas, la persona que echó una mano en el momento justo, lo que harías distinto. Eso es lo que le sirve a otro.',
      'Empezamos en Barcelona porque es donde vivimos, pero no es una frontera. Lo que se construye aquí se parece bastante a lo que se construye en otros sitios de Europa y del continente, y no hay nada que impida que circule.',
    ],
    boussoleSurtitre: 'Nuestra brújula',
    boussoleTitre: 'Conectar · Construir · Impactar',
    verbes: [
      { mot: 'Conectar', texte: 'Poner en la misma sala a gente que no se habría cruzado de otro modo. Suena tonto, pero casi todo empieza ahí.' },
      { mot: 'Construir', texte: 'Pasar de la conversación a algo concreto: un proyecto, una colaboración, un oficio transmitido. Nos interesa lo que aguanta en el tiempo.' },
      { mot: 'Impactar', texte: 'Conseguir que cuente más allá de la tarde — para quienes están, y para quienes lean lo que allí se dijo.' },
    ],
    publicSurtitre: 'Público',
    publicTitre: '¿Para quién?',
    publics: [
      'Los africanos y las personas de las diásporas africanas',
      'Jóvenes y adultos con ganas de descubrir otras trayectorias y otras posibilidades',
      'Emprendedores y personas con un proyecto entre manos',
      'Profesionales y quienes tienen un oficio o una experiencia que compartir',
      'Asociaciones, empresas, instituciones y demás agentes que puedan enriquecer estos intercambios',
    ],
    publicNote: 'MUSIMA no se dirige solo a un público africano. Si tienes ganas de descubrir, de aprender, de intercambiar o de echar una mano, tienes tu sitio aquí.',
    territoireSurtitre: 'Territorio',
    territoireTitre: 'Empezamos en Barcelona',
    territoireSous: 'Un punto de anclaje, no un límite.',
    territoire: [
      'El punto de partida es la diáspora africana y lo que construye en su entorno. MUSIMA arranca en Cataluña, en España, sin definirse como una iniciativa limitada a un territorio.',
      'Con el tiempo, la asociación puede dar luz a personas, proyectos e iniciativas en distintos territorios, en particular en Europa y en África.',
    ],
    aujourdhui: 'Hoy',
    horizon: 'Horizonte',
    horizonValeur: 'Europa y África',
    particulariteSurtitre: 'Nuestra particularidad',
    particulariteTitre: 'Demostrar que es posible',
    particularite: [
      'MUSIMA no se define ni como una simple organizadora de eventos, ni como una red profesional, ni como una plataforma que promete repartir oportunidades.',
      'Su particularidad son tres cosas, y van juntas: dar luz a personas y a sus trayectorias, crear las ocasiones de encontrarse, y hacer que las ideas, las experiencias y los oficios circulen en lugar de quedarse en una cocina.',
      'El diferencial es también esa voluntad de demostrar que es posible. No diciéndole a la gente que puede conseguirlo, sino mostrándole personas reales, trayectorias reales y realizaciones reales.',
    ],
    citation: 'Un encuentro de MUSIMA puede empezar por una conferencia, pero lo que sale de ahí va más lejos: un contacto nuevo, una idea, un aprendizaje, una colaboración, un proyecto, o simplemente una posibilidad que alguien no se había planteado.',
    tonSurtitre: 'Nuestra manera de hablar',
    tonTitre: 'Ni miserabilismo, ni escaparate',
    tons: ['Humano', 'Accesible', 'Positivo sin motivación artificial', 'Curioso', 'Contemporáneo', 'Abierto', 'Ambicioso pero sencillo', 'Concreto'],
    ton: [
      'MUSIMA no habla de los africanos solo a través de sus dificultades. Tampoco busca presentar una imagen artificialmente perfecta.',
      'Muestra lo que existe: trayectorias, experiencias, logros, proyectos, aprendizajes, iniciativas — y también los caminos que permitieron llegar hasta ahí.',
    ],
    cadreSurtitre: 'El marco',
    cadreTitre: 'El equipo y el funcionamiento',
    cadreNote: 'Forma jurídica, fecha de creación, composición de la junta y memoria de actividades: esta información es la que hace legible una asociación ante socios e instituciones.',
  },
  fr: {
    meta: 'MUSIMA met en lumière des personnes, des parcours et des initiatives d’Africains qui entreprennent, créent et innovent. Mission, public, territoire et démarche.',
    surtitre: 'L’association',
    titre: 'Pourquoi on a monté ça',
    missionSurtitre: 'Mission',
    missionTitre: 'Pourquoi MUSIMA existe',
    mission: [
      'On n’a pas monté MUSIMA pour parler des Africains. On l’a monté pour qu’ils parlent, et pour que ce qu’ils disent ne reste pas dans une cuisine.',
      'Ce qui nous intéresse tient dans une question : comment tu t’y es pris ? Pas le résultat, pas la belle histoire lissée pour l’occasion, mais le chemin — l’argent qu’il a fallu trouver, les portes fermées, la personne qui a donné un coup de main au bon moment, ce que tu referais autrement. C’est ça qui sert à quelqu’un d’autre.',
      'On commence à Barcelone parce que c’est là qu’on vit, mais ce n’est pas une frontière. Ce qui se construit ici ressemble à ce qui se construit ailleurs en Europe et sur le continent, et rien n’empêche que ça circule.',
    ],
    boussoleSurtitre: 'Notre boussole',
    boussoleTitre: 'Connecter · Bâtir · Impacter',
    verbes: [
      { mot: 'Connecter', texte: 'Mettre dans la même pièce des gens qui ne se seraient pas croisés autrement. C’est bête, mais presque tout part de là.' },
      { mot: 'Bâtir', texte: 'Passer de la conversation à quelque chose de concret : un projet, une collaboration, une compétence transmise. On s’intéresse à ce qui tient dans le temps.' },
      { mot: 'Impacter', texte: 'Faire en sorte que ça compte au-delà de la soirée — pour les personnes présentes, et pour celles qui liront ce qui s’y est dit.' },
    ],
    publicSurtitre: 'Public',
    publicTitre: 'Pour qui ?',
    publics: [
      'Les Africains et les personnes issues des diasporas africaines',
      'Les jeunes et les adultes qui souhaitent découvrir d’autres parcours et d’autres possibilités',
      'Les entrepreneurs et les porteurs de projets',
      'Les professionnels et les personnes disposant d’un savoir-faire ou d’une expérience à partager',
      'Les associations, entreprises, institutions et autres acteurs qui peuvent enrichir ces échanges',
    ],
    publicNote: 'MUSIMA ne s’adresse pas qu’à un public africain. Si tu as envie de découvrir, d’apprendre, d’échanger ou de donner un coup de main, tu es à ta place.',
    territoireSurtitre: 'Territoire',
    territoireTitre: 'On commence à Barcelone',
    territoireSous: 'Un point d’ancrage, pas une limite.',
    territoire: [
      'Le point de départ est la diaspora africaine et ce qu’elle construit dans son environnement. MUSIMA démarre en Catalogne, en Espagne, sans se définir comme une initiative limitée à un territoire.',
      'À terme, l’association peut mettre en lumière des personnes, des projets et des initiatives dans différents territoires, notamment en Europe et en Afrique.',
    ],
    aujourdhui: 'Aujourd’hui',
    horizon: 'Horizon',
    horizonValeur: 'Europe & Afrique',
    particulariteSurtitre: 'Notre particularité',
    particulariteTitre: 'Montrer que c’est possible',
    particularite: [
      'MUSIMA ne se définit ni comme une simple organisation d’événements, ni comme un réseau professionnel, ni comme une plateforme qui promet de distribuer des opportunités.',
      'Sa particularité tient à trois choses, et elles vont ensemble : mettre en lumière des personnes et leurs parcours, créer les occasions de se rencontrer, et faire en sorte que les idées, les expériences et les savoir-faire circulent au lieu de rester dans une cuisine.',
      'Le différenciateur est aussi cette volonté de montrer que c’est possible. Pas simplement en disant aux gens qu’ils peuvent réussir, mais en leur donnant à voir des personnes réelles, des parcours réels et des réalisations réelles.',
    ],
    citation: 'Une rencontre MUSIMA peut commencer par une conférence, mais ce qui peut en découler va plus loin : une nouvelle connaissance, une idée, un apprentissage, une collaboration, un projet, ou simplement une nouvelle possibilité que quelqu’un n’avait pas envisagée auparavant.',
    tonSurtitre: 'Notre façon de parler',
    tonTitre: 'Ni misérabilisme, ni vitrine',
    tons: ['Humain', 'Accessible', 'Positif sans être artificiellement motivant', 'Curieux', 'Contemporain', 'Ouvert', 'Ambitieux mais simple', 'Concret'],
    ton: [
      'MUSIMA ne parle pas des Africains uniquement à travers leurs difficultés. Elle ne cherche pas non plus à présenter une image artificiellement parfaite.',
      'Elle montre ce qui existe : des parcours, des expériences, des réussites, des projets, des apprentissages, des initiatives — et aussi les chemins qui ont permis d’y arriver.',
    ],
    cadreSurtitre: 'Le cadre',
    cadreTitre: 'L’équipe et le fonctionnement',
    cadreNote: 'Statut juridique, date de création, composition du bureau et rapport d’activité : ces informations rendent l’association lisible pour les partenaires et les institutions.',
  },
  en: {
    meta: 'MUSIMA shines a light on the people, paths and initiatives of Africans who start things, create and innovate. Mission, audience, territory and approach.',
    surtitre: 'The association',
    titre: 'Why we set this up',
    missionSurtitre: 'Mission',
    missionTitre: 'Why MUSIMA exists',
    mission: [
      'We didn’t set MUSIMA up to talk about Africans. We set it up so they can talk, and so that what they say doesn’t stay in somebody’s kitchen.',
      'What interests us fits into one question: how did you do it? Not the result, not the neat story told afterwards, but the road — the money you had to find, the doors that stayed shut, the person who helped at the right moment, what you’d do differently. That’s the part somebody else can use.',
      'We start in Barcelona because that’s where we live, but it isn’t a border. What gets built here looks a lot like what gets built elsewhere in Europe and on the continent, and there’s nothing to stop it travelling.',
    ],
    boussoleSurtitre: 'Our compass',
    boussoleTitre: 'Connect · Build · Impact',
    verbes: [
      { mot: 'Connect', texte: 'Put people in the same room who would never have crossed paths otherwise. It sounds daft, but almost everything starts there.' },
      { mot: 'Build', texte: 'Move from conversation to something concrete: a project, a collaboration, a skill passed on. What interests us is what holds up over time.' },
      { mot: 'Impact', texte: 'Make it count beyond the evening — for the people in the room, and for those who read what was said there.' },
    ],
    publicSurtitre: 'Audience',
    publicTitre: 'Who is it for?',
    publics: [
      'Africans and people from the African diasporas',
      'Young people and adults who want to discover other paths and other possibilities',
      'People starting a business or carrying a project',
      'Professionals and anyone with a craft or an experience to share',
      'Associations, companies, institutions and other players who can enrich these exchanges',
    ],
    publicNote: 'MUSIMA is not only for an African audience. If you want to discover, learn, exchange or lend a hand, you belong here.',
    territoireSurtitre: 'Territory',
    territoireTitre: 'We start in Barcelona',
    territoireSous: 'An anchor point, not a limit.',
    territoire: [
      'The starting point is the African diaspora and what it builds around it. MUSIMA begins in Catalonia, in Spain, without defining itself as an initiative bounded by one territory.',
      'In time, the association can shine a light on people, projects and initiatives in different territories, particularly in Europe and in Africa.',
    ],
    aujourdhui: 'Today',
    horizon: 'Horizon',
    horizonValeur: 'Europe & Africa',
    particulariteSurtitre: 'What sets us apart',
    particulariteTitre: 'Showing that it can be done',
    particularite: [
      'MUSIMA does not define itself as an event organiser, nor as a professional network, nor as a platform promising to hand out opportunities.',
      'What sets it apart is three things, and they go together: shining a light on people and their paths, making the occasions to meet, and getting ideas, experience and craft to travel instead of staying in someone’s kitchen.',
      'The difference is also that will to show it can be done. Not by telling people they can make it, but by putting real people, real paths and real achievements in front of them.',
    ],
    citation: 'A MUSIMA gathering may start with a talk, but what comes out of it goes further: a new contact, an idea, something learnt, a collaboration, a project, or simply a possibility somebody had not considered before.',
    tonSurtitre: 'How we speak',
    tonTitre: 'No pity, no shop window',
    tons: ['Human', 'Accessible', 'Positive without forced motivation', 'Curious', 'Contemporary', 'Open', 'Ambitious but plain', 'Concrete'],
    ton: [
      'MUSIMA does not speak about Africans only through their difficulties. Nor does it try to present an artificially perfect picture.',
      'It shows what exists: paths, experiences, achievements, projects, things learnt, initiatives — and also the roads that made them possible.',
    ],
    cadreSurtitre: 'The frame',
    cadreTitre: 'The team and how it runs',
    cadreNote: 'Legal form, founding date, board composition and activity report: this is the information that makes an association legible to partners and institutions.',
  },
  ca: {
    meta: 'MUSIMA dona llum a persones, trajectòries i iniciatives d’africans que emprenen, creen i innoven. Missió, públic, territori i manera de treballar.',
    surtitre: 'L’associació',
    titre: 'Per què vam muntar això',
    missionSurtitre: 'Missió',
    missionTitre: 'Per què existeix MUSIMA',
    mission: [
      'No vam muntar MUSIMA per parlar dels africans, sinó perquè parlin ells i perquè el que diuen no es quedi en una cuina.',
      'El que ens interessa cap en una pregunta: com ho vas fer? No el resultat, ni la història bonica que s’explica després, sinó el camí — els diners que va caldre trobar, les portes tancades, la persona que va donar un cop de mà en el moment just, què faries diferent. Això és el que li serveix a un altre.',
      'Comencem a Barcelona perquè és on vivim, però no és una frontera. El que es construeix aquí s’assembla força al que es construeix en altres llocs d’Europa i del continent, i no hi ha res que impedeixi que circuli.',
    ],
    boussoleSurtitre: 'La nostra brúixola',
    boussoleTitre: 'Connectar · Construir · Impactar',
    verbes: [
      { mot: 'Connectar', texte: 'Posar a la mateixa sala gent que no s’hauria creuat d’una altra manera. Sona ximple, però gairebé tot comença aquí.' },
      { mot: 'Construir', texte: 'Passar de la conversa a alguna cosa concreta: un projecte, una col·laboració, un ofici transmès. Ens interessa el que aguanta amb el temps.' },
      { mot: 'Impactar', texte: 'Aconseguir que compti més enllà de la tarda — per als qui hi són, i per als qui llegeixin el que s’hi va dir.' },
    ],
    publicSurtitre: 'Públic',
    publicTitre: 'Per a qui?',
    publics: [
      'Els africans i les persones de les diàspores africanes',
      'Joves i adults amb ganes de descobrir altres trajectòries i altres possibilitats',
      'Emprenedors i persones amb un projecte entre mans',
      'Professionals i qui tingui un ofici o una experiència per compartir',
      'Associacions, empreses, institucions i altres agents que puguin enriquir aquests intercanvis',
    ],
    publicNote: 'MUSIMA no s’adreça només a un públic africà. Si tens ganes de descobrir, d’aprendre, d’intercanviar o de donar un cop de mà, tens el teu lloc aquí.',
    territoireSurtitre: 'Territori',
    territoireTitre: 'Comencem a Barcelona',
    territoireSous: 'Un punt d’ancoratge, no un límit.',
    territoire: [
      'El punt de partida és la diàspora africana i el que construeix al seu entorn. MUSIMA arrenca a Catalunya, a Espanya, sense definir-se com una iniciativa limitada a un territori.',
      'Amb el temps, l’associació pot donar llum a persones, projectes i iniciatives en diferents territoris, en particular a Europa i a l’Àfrica.',
    ],
    aujourdhui: 'Avui',
    horizon: 'Horitzó',
    horizonValeur: 'Europa i Àfrica',
    particulariteSurtitre: 'La nostra particularitat',
    particulariteTitre: 'Demostrar que es pot',
    particularite: [
      'MUSIMA no es defineix ni com una simple organitzadora d’esdeveniments, ni com una xarxa professional, ni com una plataforma que promet repartir oportunitats.',
      'La seva particularitat són tres coses, i van juntes: donar llum a persones i a les seves trajectòries, crear les ocasions de trobar-se, i fer que les idees, les experiències i els oficis circulin en lloc de quedar-se en una cuina.',
      'El diferencial és també aquesta voluntat de demostrar que es pot. No dient a la gent que pot aconseguir-ho, sinó mostrant-li persones reals, trajectòries reals i realitzacions reals.',
    ],
    citation: 'Una trobada de MUSIMA pot començar per una conferència, però el que en surt va més lluny: un contacte nou, una idea, un aprenentatge, una col·laboració, un projecte, o simplement una possibilitat que algú no s’havia plantejat.',
    tonSurtitre: 'La nostra manera de parlar',
    tonTitre: 'Ni miserabilisme, ni aparador',
    tons: ['Humà', 'Accessible', 'Positiu sense motivació artificial', 'Curiós', 'Contemporani', 'Obert', 'Ambiciós però senzill', 'Concret'],
    ton: [
      'MUSIMA no parla dels africans només a través de les seves dificultats. Tampoc busca presentar una imatge artificialment perfecta.',
      'Mostra el que existeix: trajectòries, experiències, èxits, projectes, aprenentatges, iniciatives — i també els camins que van permetre arribar-hi.',
    ],
    cadreSurtitre: 'El marc',
    cadreTitre: 'L’equip i el funcionament',
    cadreNote: 'Forma jurídica, data de creació, composició de la junta i memòria d’activitats: aquesta informació és la que fa llegible una associació davant de socis i institucions.',
  },
} as const;
const x = textes[langue];
---

<Base
  titre={x.titre}
  description={x.meta}
  langue={langue}
  alternatives={alternatives}
>
  <EntetePage
    surtitre={x.surtitre}
    titre={x.titre}
    chapo={champ(site.phrase, langue)}
    ariane={[{ libelle: x.surtitre }]}
  />

  <!-- ============ MISSION ============ -->
  <section class="section conteneur colonnes colonnes--collant">
    <div class="colonne-titre">
      <EnteteSection surtitre={x.missionSurtitre} titre={x.missionTitre} />
    </div>
    <div class="prose">
      {x.mission.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <figure class="salle tirage">
    <Image
      src={salle}
      alt={t('salleAlt')}
      widths={[720, 1100, 1600]}
      sizes="100vw"
    />
  </figure>

  <!-- ============ LES TROIS VERBES ============ -->
  <section class="section conteneur colonnes colonnes--decale colonnes--collant">
    <div class="colonne-titre">
      <EnteteSection surtitre={x.boussoleSurtitre} titre={x.boussoleTitre} />
    </div>
    <ol class="verbes">
      {x.verbes.map((verbe, index) => (
        <li class="verbe apparait" style={`--i:${index}`}>
          <span class="trait-croissant verbe__trait" style={`--i:${index}`}></span>
          <span class="verbe__rang" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="verbe__mot">{verbe.mot}</h3>
          <p class="verbe__texte">{verbe.texte}</p>
        </li>
      ))}
    </ol>
  </section>

  <hr class="conteneur filet" />

  <!-- ============ PUBLIC ============ -->
  <section class="section conteneur colonnes colonnes--collant">
    <div class="colonne-titre">
      <EnteteSection surtitre={x.publicSurtitre} titre={x.publicTitre} />
    </div>
    <div class="pile pile-5">
      <ul class="liste-traits">
        {x.publics.map((element) => <li>{element}</li>)}
      </ul>
      <p class="note">{x.publicNote}</p>
    </div>
  </section>

  <hr class="conteneur filet" />

  <!-- ============ TERRITOIRE ============ -->
  <section class="section conteneur colonnes colonnes--decale colonnes--collant">
    <div class="colonne-titre">
      <EnteteSection surtitre={x.territoireSurtitre} titre={x.territoireTitre} />
      <p class="sous-titre">{x.territoireSous}</p>
    </div>
    <div class="pile pile-5">
      <div class="prose">
          {x.territoire.map((p) => <p>{p}</p>)}
        </div>
      <div class="ancrages">
        <span class="ancrages__lien" aria-hidden="true"></span>
        <div class="ancrage">
          <span class="ancrage__etiquette">{x.aujourdhui}</span>
          <span class="ancrage__valeur">{champ(site.contact.region, langue)}, {champ(site.contact.pays, langue)}</span>
        </div>
        <div class="ancrage">
          <span class="ancrage__etiquette">{x.horizon}</span>
          <span class="ancrage__valeur">{x.horizonValeur}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DIFFÉRENCIATEUR ============ -->
  <section class="section scene">
    <div class="conteneur colonnes">
      <div class="colonne-titre">
        <EnteteSection surtitre={x.particulariteSurtitre} titre={x.particulariteTitre} />
      </div>
      <div class="prose">
        {x.particularite.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  {/* La meilleure phrase du site : seule à l'écran, rien d'autre. */}
  <section class="section scene citation-pleine">
    <blockquote class="conteneur citation">
      <span class="citation__marque" aria-hidden="true">&ldquo;</span>
      <p class="apparait apparait--titre">{x.citation}</p>
    </blockquote>
  </section>

  <!-- ============ TON ============ -->
  <section class="section conteneur colonnes colonnes--collant">
    <div class="colonne-titre">
      <EnteteSection surtitre={x.tonSurtitre} titre={x.tonTitre} />
    </div>
    <div class="pile pile-6">
      <ul class="tons">
        {x.tons.map((ton) => <li><span class="puce puce--sourde">{ton}</span></li>)}
      </ul>
      <div class="prose">
          {x.ton.map((p) => <p>{p}</p>)}
        </div>
    </div>
  </section>

  {enChantier && (
  <hr class="conteneur filet" />
  )}

  <!-- ============ ÉQUIPE & CADRE ============ -->
  {enChantier && (
  <section class="section conteneur colonnes colonnes--decale">
    <div class="colonne-titre">
      <EnteteSection surtitre={x.cadreSurtitre} titre={x.cadreTitre} />
    </div>
    <div class="pile pile-4">
