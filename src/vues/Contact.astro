    labelOu: 'Où',
    labelAdresse: 'Adresse',
    reseaux: 'Réseaux',
    presse: 'Presse',
    pressseTexte: 'Journalistes et médias : un dossier de presse et des visuels en haute définition seront mis à disposition ici.',
    sujets: [
      'Proposer une intervention',
      'Proposer un sujet ou un portrait',
      'Adhérer à l’association',
