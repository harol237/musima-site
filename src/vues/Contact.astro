---
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import ARemplir from '~/components/ARemplir.astro';
import site from '~/data/site.json';
import { enChantier } from '~/lib/contenu';
import { chemin, type Langue } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';

const aRemplir = (valeur: string) => valeur.startsWith('[');
const reseaux = site.reseaux.filter((r) => enChantier || !aRemplir(r.url));
const sujets = [
  'Proposer une intervention',
  'Proposer un sujet ou un portrait',
  'Devenir partenaire',
  'Devenir bénévole',
  'Presse',
  'Autre',
];

interface Props { langue: Langue; alternatives: Record<Langue, string> }
const { langue, alternatives } = Astro.props;
const t = traducteur(langue);
---

<Base
  titre="Contact"
  description="Écrire à MUSIMA : proposer une intervention, un sujet, un partenariat, ou poser une question."
  langue={langue}
  alternatives={alternatives}
>
  <EntetePage
    surtitre="Contact"
    titre="Nous écrire"
    chapo="Une proposition, une question, une envie de contribuer : le plus simple est encore d’écrire."
    ariane={[{ libelle: 'Contact' }]}
  />

  <section class="section conteneur contact">
    <div class="contact__form">
      <h2 class="t-section">Formulaire</h2>
      <p class="note">
        Ce formulaire ouvre votre logiciel de messagerie avec le message déjà rédigé — il n'y a
        aucun intermédiaire, votre message arrive directement dans notre boîte. Si vous préférez
        écrire vous-même, l'adresse est juste à côté.
      </p>

      <form class="formulaire" data-formulaire-mailto data-destinataire={site.contact.email}>
        <div class="champ">
          <label for="nom">Nom et prénom</label>
          <input id="nom" name="nom" type="text" autocomplete="name" required />
        </div>

        <div class="champ">
          <label for="email">Adresse e-mail</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="champ">
          <label for="sujet">Sujet</label>
          <select id="sujet" name="sujet">
            {sujets.map((sujet) => <option value={sujet}>{sujet}</option>)}
          </select>
        </div>

        <div class="champ">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required></textarea>
        </div>

        <p class="champ__aide" id="aide-rgpd">
          Rien n'est enregistré sur ce site : les informations saisies partent directement par
          e-mail et servent uniquement à répondre à votre message. Voir la
          <a href="/confidentialite" class="lien">politique de confidentialité</a>.
        </p>

        <button type="submit" class="bouton" aria-describedby="aide-rgpd">Envoyer</button>

        <noscript>
          <p class="champ__aide">
            Le formulaire a besoin de JavaScript pour préparer le message. Écrivez-nous
            directement à <a href={`mailto:${site.contact.email}`} class="lien">{site.contact.email}</a>.
          </p>
        </noscript>
      </form>
    </div>

    <aside class="contact__infos" aria-label="Coordonnées">
      <div class="encart">
        <h2 class="encart__titre">Coordonnées</h2>
        <dl class="infos">
          <div>
            <dt>E-mail</dt>
            <dd>
              {aRemplir(site.contact.email)
                ? <ARemplir libelle="EMAIL À AJOUTER" forme="ligne" />
                : <a href={`mailto:${site.contact.email}`} class="lien">{site.contact.email}</a>}
            </dd>
          </div>
          <div>
            <dt>Où</dt>
            <dd>{site.contact.ville_siege}, {site.contact.region}, {site.contact.pays}</dd>
          </div>
          {(!aRemplir(site.contact.adresse) || enChantier) && (
          <div>
            <dt>Adresse</dt>
            <dd>
              {aRemplir(site.contact.adresse)
                ? <ARemplir libelle="ADRESSE À AJOUTER" forme="ligne" />
                : site.contact.adresse}
            </dd>
          </div>
          )}
        </dl>
      </div>

      <div class="encart">
        <h2 class="encart__titre">Réseaux</h2>
        <ul class="encart__liste">
          {reseaux.map((reseau) => (
            <li>
              {aRemplir(reseau.url)
                ? <span>{reseau.nom} <ARemplir type="lien" forme="ligne" /></span>
                : <a href={reseau.url} class="lien" rel="me noopener">{reseau.nom}</a>}
            </li>
          ))}
        </ul>
      </div>

      {enChantier && (
      <div class="encart">
        <h2 class="encart__titre">Presse</h2>
        <p class="encart__texte">
          Journalistes et médias : un dossier de presse et des visuels en haute définition seront
          mis à disposition ici.
        </p>
        <ARemplir libelle="DOSSIER DE PRESSE À AJOUTER" />
      </div>
      )}
    </aside>
  </section>
  <script>
    // Le formulaire n'envoie rien lui-même : il compose un e-mail et laisse
    // la personne l'envoyer depuis sa propre messagerie. Zéro donnée stockée,
    // zéro service tiers — et ça marche dès le premier jour.
    const formulaire = document.querySelector<HTMLFormElement>('[data-formulaire-mailto]');

    formulaire?.addEventListener('submit', (evenement) => {
      evenement.preventDefault();
      const champs = new FormData(formulaire);
      const destinataire = formulaire.dataset.destinataire ?? '';
      const nom = String(champs.get('nom') ?? '');
      const email = String(champs.get('email') ?? '');
      const sujet = String(champs.get('sujet') ?? 'Message');
      const message = String(champs.get('message') ?? '');

      const corps = `${message}\n\n—\n${nom}\n${email}`;
      window.location.href =
        `mailto:${destinataire}?subject=${encodeURIComponent(`[MUSIMA] ${sujet}`)}` +
        `&body=${encodeURIComponent(corps)}`;
    });
  </script>
</Base>

<style>
  .contact { display: grid; gap: var(--e-8); align-items: start; }
  @media (min-width: 62rem) { .contact { grid-template-columns: minmax(0, 1fr) 21rem; gap: var(--e-9); } }

  .contact__form { display: flex; flex-direction: column; gap: var(--e-4); max-width: 34rem; }
  .note { font-size: var(--t-300); color: var(--encre-douce); line-height: 1.65; }

  .formulaire { display: flex; flex-direction: column; gap: var(--e-5); margin-top: var(--e-3); }
  .champ { display: flex; flex-direction: column; gap: var(--e-2); }
  .champ label {
    font-family: var(--f-titre);
    font-size: var(--t-200);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--encre-douce);
  }
  .champ :is(input, select, textarea) {
    padding: 0.75em 0.9em;
    border: 1px solid var(--trait-fort);
    border-radius: var(--r-carte);
    background: var(--surface);
    font-size: var(--t-300);
    font-family: var(--f-lecture);
  }
  .champ textarea { resize: vertical; }
  .champ__aide { font-size: var(--t-200); color: var(--encre-faible); line-height: 1.5; }
  .formulaire .bouton:disabled { opacity: 0.45; cursor: not-allowed; }

  .contact__infos { display: flex; flex-direction: column; gap: var(--e-4); }
  .encart { border: 1px solid var(--trait); border-radius: var(--r-carte); background: var(--surface); padding: var(--e-5); }
  .encart__titre { font-size: var(--t-200); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--terre); margin-bottom: var(--e-4); }
  .encart__texte { font-size: var(--t-300); color: var(--encre-douce); line-height: 1.6; margin-bottom: var(--e-4); }
  .encart__liste { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--e-2); font-size: var(--t-300); }

  .infos { display: flex; flex-direction: column; gap: var(--e-4); margin: 0; }
  .infos div { display: flex; flex-direction: column; gap: 2px; }
  .infos dt { font-family: var(--f-titre); font-size: var(--t-100); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--encre-faible); }
  .infos dd { margin: 0; font-size: var(--t-300); }
  .infos dd a { display: inline-block; padding-block: 0.25rem; }
</style>
