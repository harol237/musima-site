---
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import ARemplir from '~/components/ARemplir.astro';
import site from '~/data/site.json';
import { enChantier } from '~/lib/contenu';
import { chemin, type Langue } from '~/i18n/config';
import { champ } from '~/i18n/site';

interface Props { langue: Langue; alternatives: Record<Langue, string> }
const { langue, alternatives } = Astro.props;

const aRemplir = (valeur: string) => valeur.startsWith('[');
const reseaux = site.reseaux.filter((r) => enChantier || !aRemplir(r.url));

