---
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import FormulaireContact from '~/components/FormulaireContact.astro';
import ARemplir from '~/components/ARemplir.astro';
import site from '~/data/site.json';
import { enChantier } from '~/lib/contenu';
import { chemin, type Langue } from '~/i18n/config';
import { champ } from '~/i18n/site';

interface Props { langue: Langue; alternatives: Record<Langue, string> }
const { langue, alternatives } = Astro.props;

const aRemplir = (valeur: string) => valeur.startsWith('[');
const reseaux = site.reseaux.filter((r) => enChantier || !aRemplir(r.url));

/* Textes propres à cette page. Assez courts pour vivre ici plutôt que
   dans le dictionnaire général, qui sert les chaînes vues partout. */
const textes = {
  es: {
    titre: 'Escríbenos',
    surtitre: 'Contacto',
    chapo: 'Una propuesta, una duda, ganas de aportar algo: lo más sencillo sigue siendo escribir.',
    meta: 'Escribir a MUSIMA: proponer una intervención, un tema, una colaboración, o hacer una pregunta.',
    formulaire: 'Formulario',
    coordonnees: 'Datos de contacto',
    labelEmail: 'Correo',
    labelOu: 'Dónde',
    reseaux: 'Redes',
    presse: 'Prensa',
    pressseTexte: 'Periodistas y medios: aquí se pondrá a disposición un dossier de prensa y material gráfico en alta resolución.',
  },
  fr: {
    titre: 'Nous écrire',
    surtitre: 'Contact',
    chapo: 'Une proposition, une question, une envie de contribuer : le plus simple est encore d’écrire.',
    meta: 'Écrire à MUSIMA : proposer une intervention, un sujet, un partenariat, ou poser une question.',
    formulaire: 'Formulaire',
    coordonnees: 'Coordonnées',
    labelEmail: 'E-mail',
    labelOu: 'Où',
    reseaux: 'Réseaux',
    presse: 'Presse',
    pressseTexte: 'Journalistes et médias : un dossier de presse et des visuels en haute définition seront mis à disposition ici.',
  },
  en: {
    titre: 'Write to us',
    surtitre: 'Contact',
    chapo: 'A proposal, a question, an urge to contribute: the simplest thing is still to write.',
    meta: 'Write to MUSIMA: propose a talk, a subject, a partnership, or ask a question.',
    formulaire: 'Form',
    coordonnees: 'Details',
    labelEmail: 'Email',
    labelOu: 'Where',
    reseaux: 'Social',
    presse: 'Press',
    pressseTexte: 'Journalists and media: a press kit and high-resolution images will be made available here.',
  },
  ca: {
    titre: 'Escriu-nos',
    surtitre: 'Contacte',
    chapo: 'Una proposta, un dubte, ganes d’aportar alguna cosa: el més senzill segueix sent escriure.',
    meta: 'Escriure a MUSIMA: proposar una intervenció, un tema, una col·laboració, o fer una pregunta.',
    formulaire: 'Formulari',
    coordonnees: 'Dades de contacte',
    labelEmail: 'Correu',
    labelOu: 'On',
    reseaux: 'Xarxes',
    presse: 'Premsa',
    pressseTexte: 'Periodistes i mitjans: aquí es posarà a disposició un dossier de premsa i material gràfic en alta resolució.',
  },
} as const;
const x = textes[langue];
---

<Base titre={x.titre} description={x.meta} langue={langue} alternatives={alternatives}>
  <EntetePage
    surtitre={x.surtitre}
    titre={x.titre}
    chapo={x.chapo}
    ariane={[{ libelle: x.surtitre }]}
  />

  <section class="section conteneur contact">
    <div class="contact__form">
      <h2 class="t-section">{x.formulaire}</h2>

      <FormulaireContact langue={langue} />
    </div>

    <aside class="contact__infos" aria-label={x.coordonnees}>
      <div class="encart">
        <h2 class="encart__titre">{x.coordonnees}</h2>
        <dl class="infos">
          <div>
            <dt>{x.labelEmail}</dt>
            <dd><a href={`mailto:${site.contact.email}`} class="lien">{site.contact.email}</a></dd>
          </div>
          {/* Une seule ligne de lieu, en forme courte. L'ancienne ligne
              « Adresse », qui donnait rue et code postal, est retirée :
              on écrit à l'association, on ne s'y présente pas. */}
          <div>
            <dt>{x.labelOu}</dt>
            <dd>{champ(site.contact.siege, langue)}</dd>
          </div>
        </dl>
      </div>

      {reseaux.length > 0 && (
        <div class="encart">
          <h2 class="encart__titre">{x.reseaux}</h2>
          <ul class="encart__liste">
            {reseaux.map((reseau) => (
              <li>
                {aRemplir(reseau.url)
                  ? <span>{reseau.nom} <ARemplir type="lien" forme="ligne" /></span>
                  : <a href={reseau.url} class="lien" rel="me noopener">{reseau.nom}</a>}
              </li>
            ))}
          </ul>
        </div>
      )}

      {enChantier && (
        <div class="encart">
          <h2 class="encart__titre">{x.presse}</h2>
          <p class="encart__texte">{x.pressseTexte}</p>
          <ARemplir libelle="DOSSIER DE PRESSE À AJOUTER" />
        </div>
      )}
    </aside>
  </section>

</Base>

<style>
  .contact { display: grid; gap: var(--e-8); align-items: start; }
  @media (min-width: 62rem) { .contact { grid-template-columns: minmax(0, 1fr) 21rem; gap: var(--e-9); } }

  .contact__form { display: flex; flex-direction: column; gap: var(--e-4); max-width: 34rem; }

  .contact__infos { display: flex; flex-direction: column; gap: var(--e-4); }
  .encart { border: 1px solid var(--trait); border-radius: var(--r-carte); background: var(--surface); padding: var(--e-5); }
  .encart__titre { font-size: var(--t-200); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--terre); margin-bottom: var(--e-4); }
  .encart__texte { font-size: var(--t-300); color: var(--encre-douce); line-height: 1.6; margin-bottom: var(--e-4); }
  .encart__liste { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--e-2); font-size: var(--t-300); }

  .infos { display: flex; flex-direction: column; gap: var(--e-4); margin: 0; }
  .infos div { display: flex; flex-direction: column; gap: 2px; }
  .infos dt { font-family: var(--f-titre); font-size: var(--t-100); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--encre-faible); }
  .infos dd { margin: 0; font-size: var(--t-300); }
  .infos dd a { display: inline-block; padding-block: 0.25rem; }
</style>
