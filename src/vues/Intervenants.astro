---
import Base from '~/layouts/Base.astro';
import EntetePage from '~/components/EntetePage.astro';
import CarteIntervenant from '~/components/CarteIntervenant.astro';
import Filtres from '~/components/Filtres.astro';
import EtatVide from '~/components/EtatVide.astro';
import BandeauCta from '~/components/BandeauCta.astro';
import { chargerIntervenants, enChantier } from '~/lib/contenu';

const intervenants = await chargerIntervenants();
const domaines = [...new Set(intervenants.flatMap((i) => i.data.domaines))].sort((a, b) =>
  a.localeCompare(b, 'fr'),
);
---

<Base
  titre="Intervenants"
  description="Les personnes invitées par MUSIMA : parcours, domaines et rencontres auxquelles elles ont participé."
  noindex={intervenants.length === 0}
>
  <EntetePage
    surtitre="Les voix"
    titre="Intervenants"
    chapo="Des personnes réelles, des parcours réels. Chaque fiche raconte d’où vient la personne, ce qu’elle construit et ce qu’elle est venue partager."
    ariane={[{ libelle: 'Intervenants' }]}
  />

  <section class="section conteneur">
    {intervenants.length > 0 ? (
      <>
        <Filtres legende="Filtrer par domaine" options={domaines} cible=".carte-intervenant" />
        <ul class="grille grille--3 liste-nue">
          {intervenants.map((intervenant) => (
            <li class="carte-intervenant" data-etiquettes={intervenant.data.domaines.join('|')}>
              <CarteIntervenant intervenant={intervenant} />
            </li>
          ))}
        </ul>
      </>
    ) : (
      <EtatVide
        titre="Les premières fiches arrivent"
        texte="Chaque personne invitée par MUSIMA aura sa fiche."
      />
    )}
  </section>

  <BandeauCta
    surtitre="Prendre la parole"
    titre="Vous avez une expérience ou un savoir-faire à partager ?"
    texte="MUSIMA cherche en permanence des parcours à mettre en lumière — dans tous les domaines."
    actions={[{ url: '/s-engager', libelle: 'Proposer une intervention' }]}
  />
</Base>

<style>
  .liste-nue { list-style: none; margin: 0; padding: 0; }
  .liste-nue li[hidden] { display: none; }
</style>
