---
import { Font } from 'astro:assets';
import Seo from '~/components/Seo.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import '~/styles/global.css';
import { chemin, etiquettes, langues, langueDefaut, type Langue } from '~/i18n/config';
import { traducteur } from '~/i18n/ui';

interface Props {
  titre: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile' | 'event';
  publieLe?: Date;
  noindex?: boolean;
  langue: Langue;
  /**
   * URL équivalente de cette page dans chaque langue. Une page de détail
   * la fournit à partir des traductions de son contenu ; à défaut, on
   * renvoie vers l'accueil de la langue plutôt que vers une page absente.
   */
  alternatives?: Partial<Record<Langue, string>>;
}
const { langue, alternatives, ...props } = Astro.props;
const t = traducteur(langue);

const versions = Object.fromEntries(
  langues.map((code) => [code, alternatives?.[code] ?? chemin(code)]),
) as Record<Langue, string>;
---

<!doctype html>
<html lang={etiquettes[langue].balise}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0e2e3f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f3f1ec" media="(prefers-color-scheme: light)" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-read" preload />

    <Seo {...props} langue={langue} versions={versions} />

    <script is:inline>
      // Applique le thème mémorisé avant le premier rendu : évite tout
      // clignotement au chargement.
      try {
        const choix = localStorage.getItem('musima-theme');
        if (choix === 'dark' || choix === 'light') {
          document.documentElement.dataset.theme = choix;
        }
      } catch (e) {
        /* stockage indisponible : on suit simplement le thème du système */
      }
    </script>

    <script is:inline define:vars={{ versions }}>
      // Préférence de langue : uniquement depuis l'accueil espagnol, qui est
      // la page d'atterrissage par défaut. Un visiteur qui a déjà choisi une
      // langue y est renvoyé ; les autres restent en espagnol. On n'intervient
      // jamais sur une adresse choisie explicitement, et `replace` préserve le
      // bouton retour.
      try {
        if (location.pathname === '/' || location.pathname === '/index.html') {
          const choix = localStorage.getItem('musima-langue');
          if (choix && choix !== 'es' && versions[choix]) {
            location.replace(versions[choix]);
          }
        }
      } catch (e) {
        /* stockage indisponible : on reste sur la langue par défaut */
      }
    </script>
  </head>

  <body>
    <a href="#contenu" class="saut-contenu">{t('sauterAuContenu')}</a>
    <Header langue={langue} alternatives={versions} />
    <main id="contenu">
      <slot />
    </main>
    <Footer langue={langue} />

    <script>
      // Révélation discrète au défilement. Sans JS ou avec animations
      // réduites, tout reste visible : la classe n'est ajoutée que si
      // l'utilisateur ne demande pas de mouvement réduit.
      const mouvementOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
      const cibles = document.querySelectorAll('.apparait, .trait-croissant');

      if (!mouvementOk || !('IntersectionObserver' in window)) {
        cibles.forEach((cible) => cible.classList.add('est-visible'));
      } else {
        const observateur = new IntersectionObserver(
          (entrees) => {
            for (const entree of entrees) {
              if (entree.isIntersecting) {
                entree.target.classList.add('est-visible');
                observateur.unobserve(entree.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        cibles.forEach((cible) => observateur.observe(cible));
      }
    </script>
  </body>
</html>
